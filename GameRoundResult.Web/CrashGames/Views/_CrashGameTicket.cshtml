@model CrashGameTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<CrashGameTicketViewModel> Localizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,CrashGameTicketViewModel" id="tolgee_namespace" readonly hidden />
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.DisplayRoundDate
                    <br />
                    @Model.RoundResult.DisplayRoundTime
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    @Model.RoundResult.DisplayResult
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            @if (!Model.HasTwoHand)
            {
                <th>@Localizer["glossary_option"]</th>
            }
            <th>@Localizer["multiplier"]</th>
            <th>@CommonLocalizer["Stake"]</th>
            <th>@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null && Model.BetLogs.Any())
        {

            @foreach (var betLog in Model.BetLogs)
            {
                @if (Model.HasTwoHand)
                {
                    if (betLog.Action != CrashGameAction.Bet)
                    {
                        var acceptBet = Model.BetLogs.First(b => b.BetKey == betLog.BetKey && b.Action == CrashGameAction.Bet);
                        <tr>
                            <td>
                                @acceptBet.DateDisplay
                                <br />
                                @acceptBet.TimeDisplay
                            </td>
                            @if (betLog.Action == CrashGameAction.Crash)
                            {
                                <td>-</td>
                            }
                            else if (betLog.Action == CrashGameAction.Refund)
                            {
                                <td>@Localizer.GetStringWithNamcespace(CrashGameTolgeeAction.Actions[betLog.Action], Model.GameName)</td>
                            }
                            else
                            {
                                <td>@betLog.DisplayMultiplier</td>
                            }
                            <td class="text-right">@betLog.DisplayAmount</td>
                            <td class="text-right">@betLog.DisplayWinAmount</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>
                            @betLog.DateDisplay
                            <br />
                            @betLog.TimeDisplay
                        </td>
                        @if (betLog.Action == CrashGameAction.Bet || betLog.Action == CrashGameAction.Crash)
                        {
                            <td colspan="2">@Localizer[CrashGameTolgeeAction.Actions[betLog.Action]]</td>

                        }
                        else
                        {
                            <td>@Localizer[CrashGameTolgeeAction.Actions[betLog.Action]]</td>
                            <td>@betLog.DisplayMultiplier</td>
                        }

                        <td class="text-right">@betLog.DisplayAmount</td>
                        <td class="text-right">@betLog.DisplayWinAmount</td>
                    </tr>
                }
            }

            <tr>
                <td colspan="@(Model.HasTwoHand ? "3" : "4")" class="text-right">
                    @if (Model.ReachMaxWin)
                    {
                        @($"({Localizer["you_reach_max_win"]})")
                    }
                    @CommonLocalizer["Total"]
                </td>
                <td class="text-right">@Model.DisplayBetWin</td>
            </tr>
            <tr class="total">
                <td colspan="@(Model.HasTwoHand ? "3" : "4")" class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                @if (Model.HasTwoHand)
                {
                    <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : "text-blue")">@Model.DisplayWinLoss</td>
                }
                else
                {
                    <td class="bold text-right @(Model.WinLossRowClassName)">@Model.DisplayWinLoss</td>
                }
            </tr>
        }
        else
        {
            <tr>
                <td colspan="@(Model.HasTwoHand ? "4" : "5")" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>
