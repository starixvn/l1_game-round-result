@model ClassicSlotTicketViewModel

@inject IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IStringLocalizer<ClassicSlotTicketViewModel> Localizer

@if (Model.HasData)
{
    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
                <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
                <th>@CommonLocalizer["Result"]</th>
            </tr>
        </thead>
        <tbody>

            <tr>
                <td>
                    @Model.RoundResult.UserTime.RoundDateFormat()
                    <br />
                    @Model.RoundResult.UserTime.RoundTimeWithSecondFormat()
                </td>
                <td>
                    @Model.RoundResult.RoundId
                    <div>@Model.FreeSpinsLabel</div>
                </td>
                <td>              
                    @await Html.PartialAsync("_ClassicSlotBoard", Model)
                </td>
            </tr>

        </tbody>
    </table>

    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th>@Localizer["Payline"]</th>
                <th>@Localizer["Symbol"]</th>
                <th>@Localizer["NoSymbol"]</th>
                <th>@Localizer["Odds"]</th>
                <th>@Localizer["Stake"]</th>
                <th>@CommonLocalizer["Win"]</th>
            </tr>
        </thead>
        <tbody>

            @await Html.PartialAsync("_Jackpot", Model)
            @await Html.PartialAsync("_WinningPaylines", Model)
            @await Html.PartialAsync("_Bonus", Model)
            @await Html.PartialAsync("_FreeSpins", Model)
            @await Html.PartialAsync("_NotWinningPaylines", Model)

            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td class="bold text-right">@CommonLocalizer["Total"]</td>
                <td class="bold text-right">@Model.RoundResult.DisplayTotalAmount.Format()</td>
                <td class="bold text-right">@Model.RoundResult.TotalBetWin.Format()</td>
            </tr>

            <tr class="total">
                <td></td>
                <td></td>
                <td></td>
                <td class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td></td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>

        </tbody>
    </table>
}
else
{

    <table class="table table-bordered table-four-guardians">
        <tbody>

            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>

        </tbody>
    </table>
}
