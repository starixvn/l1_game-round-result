@using GameRoundResult.Core.Constants

@model ClassicSlotTicketViewModel

@inject IJsonStringLocalizer<ClassicSlotTicketViewModel> Localizer


@if (Model.HasFreeSpins)
{
    var freeSpins = Model.RoundResult.SettlementResult.FreeSpins;
    <tr>
        <td></td>
        <td><img class="symbol" src="@Model.GetSymbolUrl(SlotGameConstant.FreeSpinSymbol)" asp-append-version="true" /></td>
        <td>@freeSpins.Count</td>
        <td>
            @freeSpins.Odds @Localizer["Free spins"]
        </td>
        <td>-</td>
        <td>-</td>
    </tr>
}