@using GameRoundResult.Core.Constants

@model ClassicSlotTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<ClassicSlotTicketViewModel> Localizer
@inject IOptionsSnapshot<GameConfiguration> gameConfigurationAccessor


@if (Model.HasFreeSpins)
{
    var freeSpins = Model.RoundResult.SettlementResult.FreeSpins;
    <tr>
        <td></td>
        <td><img class="symbol" src="@gameConfigurationAccessor.Value.BaseUrl/@Model.ConfigName/@(SlotGameConstant.FreeSpinSymbol).png" asp-append-version="true" /></td>
        <td>@freeSpins.Count</td>
        <td>@freeSpins.Odds @Localizer["Free spins"]</td>
        <td>-</td>
        <td>-</td>
    </tr>
}