@using GameRoundResult.Web.SlotGames.ViewModels;
@using GameRoundResult.Web.Configuration

@model ClassicSlotTicketViewModel

@inject IOptionsSnapshot<GameConfiguration> gameConfigurationAccessor

@{
    var roundResult = Model.RoundResult;
}

@foreach (var payline in roundResult.NotWinningPaylines)
{

    <tr>
        <td><img class="payline" src="@gameConfigurationAccessor.Value.BaseUrl/_shared/classicslot/dong@(payline + 1).png" asp-append-version="true" /></td>
        <td>-</td>
        <td>-</td>
        <td>-</td>
        <td class="text-right">@roundResult.Bet.Format()</td>
        <td class="text-right">0</td>
    </tr>
}