@using GameRoundResult.Core.Constants

@model ClassicSlotTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<ClassicSlotTicketViewModel> Localizer
@inject IOptionsSnapshot<GameConfiguration> gameConfigurationAccessor

@if (Model.HasBonus)
{
    var roundResult = Model.RoundResult;
    var bonus = Model.RoundResult.SettlementResult.Bonus;

    <tr>
        <td></td>
        <td><img class="symbol" src="@gameConfigurationAccessor.Value.BaseUrl/@Model.ConfigName/@(Model.SymbolImageName(SlotGameConstant.BonusSymbol.ToString())).png" asp-append-version="true" /></td>
        <td>@bonus.Count</td>
        <td>@bonus.Odds @Localizer["Bonus"]</td>
        <td>-</td>
        <td class="text-right">@roundResult.PickedBonusChestsTotalAmount.Format()</td>
    </tr>
}