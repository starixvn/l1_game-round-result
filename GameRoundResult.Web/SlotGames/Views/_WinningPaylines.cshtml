@model ClassicSlotTicketViewModel

@inject IOptionsSnapshot<GameConfiguration> gameConfigurationAccessor

@{
    var roundResult = Model.RoundResult;
}

@foreach (var winningPayline in roundResult.SettlementResult.WinningPaylines)
{
    <tr>
        <td><img class="payline" src="@gameConfigurationAccessor.Value.BaseUrl/_shared/classicslot/dong@(winningPayline.Payline + 1).png" asp-append-version="true" /></td>
        <td>
            <img class="symbol" src="@gameConfigurationAccessor.Value.BaseUrl/@Model.ConfigName/@(Model.SymbolImageName(winningPayline.Symbol)).png" alt="" asp-append-version="true" />
        </td>
        <td>@winningPayline.Count</td>
        <td>x@(winningPayline.Odds)</td>
        <td class="text-right">@roundResult.Bet.Format()</td>
        <td class="text-right">@((roundResult.Bet * winningPayline.Odds).Format())</td>
    </tr>
}