@model ClassicSlotTicketViewModel

@{
    var roundResult = Model.RoundResult;
}

@foreach (var winningPayline in roundResult.SettlementResult.WinningPaylines)
{
    <tr>
        <td><img class="payline" src="@Model.GetPaylineUrl(winningPayline.Payline)" asp-append-version="true" /></td>
        <td>
            <img class="symbol" src="@Model.GetSymbolUrl(winningPayline.Symbol)" alt="" asp-append-version="true" />
        </td>
        <td>@winningPayline.Count</td>
        <td>x@(winningPayline.Odds)</td>
        <td class="text-right">@roundResult.Bet.Format()</td>
        <td class="text-right">@((roundResult.Bet * winningPayline.Odds).Format())</td>
    </tr>
}