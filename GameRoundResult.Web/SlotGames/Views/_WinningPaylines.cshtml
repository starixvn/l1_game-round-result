@using GameRoundResult.Web.SlotGames.ViewModels;
@using GameRoundResult.Web.Configuration

@model ClassicSlotTicketViewModel

@{
    var roundResult = Model.RoundResult;
}

@foreach (var winningPayline in roundResult.SettlementResult.WinningPaylines)
{
    <tr>
        <td><img class="payline" src="~/scss/images/@Model.ConfigName/dong@(winningPayline.Payline + 1).png" asp-append-version="true" /></td>
        <td>
            <img class="symbol" src="~/scss/images/@Model.ConfigName/@(Model.SymbolImageName(winningPayline.Symbol)).png" alt="" asp-append-version="true" />
        </td>
        <td>@winningPayline.Count</td>
        <td>x@(winningPayline.Odds)</td>
        <td class="text-right">@roundResult.Bet.Format()</td>
        <td class="text-right">@((roundResult.Bet * winningPayline.Odds).Format())</td>
    </tr>
}