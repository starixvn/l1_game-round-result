@using GameRoundResult.Web.SlotGames.ViewModels;

@model ClassicSlotTicketViewModel

<table class="table-paylines">
    <tbody>
        @{
            var array = Model.RoundResult.FormatResults;
            for (var row = 0; row < array.GetLength(0); row++)
            {
                <tr>
                    @for (var column = 0; column < array.GetLength(1); column++)
                    {
                        <td>
                            <img class="symbol" src="~/scss/images/@Model.ConfigName/@(Model.SymbolImageName(array[row,column].ToString())).png" alt="" asp-append-version="true" />
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>