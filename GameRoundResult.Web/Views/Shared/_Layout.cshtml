@using System.Threading

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <environment include="Development">
        <link href="~/scss/pages/site.css" rel="stylesheet" asp-append-version="true" />
        <link href="~/css/pages/theme.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/scss/pages/site.min.css" rel="stylesheet" asp-append-version="true" />
        <link href="~/css/pages/theme.min.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    @RenderSection("Styles", required: false)

</head>
@{
    var theme = string.Empty;
    @if (Context.Request.Query["mode"].ToString() == GameRoundResult.Core.Constants.Theme.Dark)
    {
        theme = "data-them=\"dark\"";
    }

}
<!body @theme>

    <div class="main-container">
        @RenderBody()
    </div>
    <div id="overlay">
        <div class="pulse-container">
            <div class="pulse-bubble pulse-bubble-1"></div>
            <div class="pulse-bubble pulse-bubble-2"></div>
            <div class="pulse-bubble pulse-bubble-3"></div>
        </div>
    </div>
    <input type="hidden" value="@Thread.CurrentThread.CurrentCulture.Name" id="culture" />
    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    </environment>
    @RenderSection("Scripts", required: false)
</!body>

</html>