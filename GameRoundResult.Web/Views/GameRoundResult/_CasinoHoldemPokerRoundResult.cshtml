@inject IJsonStringLocalizer<RoundResultViewModel> Localizer

<table class="table table-bordered sticky-table table-dragon-tiger" style="width:100%">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"]</th>
            <th class="col-round-id">@Localizer["Round"]</th>
            <th>@Localizer["Player"]</th>
            <th>@Localizer["Dealer"]</th>
            <th>@Localizer["Stake"]</th>
            <th>@Localizer["WinLoss"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>
