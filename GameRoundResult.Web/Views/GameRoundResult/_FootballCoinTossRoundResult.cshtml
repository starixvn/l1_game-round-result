@inject IJsonStringLocalizer<RoundResultViewModel> Localizer

<link href="~/scss/pages/football-cointoss.min.css" rel="stylesheet" asp-append-version="true" />

<table class="table table-bordered sticky-table table-dragon-tiger bandar-qiuqiu-table" style="width:100%">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th class="col-result" style="min-width: 350px;">@Localizer["Result"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>