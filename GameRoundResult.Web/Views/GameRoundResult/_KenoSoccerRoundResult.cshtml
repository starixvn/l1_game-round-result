@inject IStringLocalizer<RoundResultViewModel> Localizer

<table class="table table-bordered sticky-table table-keno-soccer" style="width:100%">
    <thead>
        <tr>
            <th rowspan="2" class="col-date">@Localizer["Date"]</th>
            <th rowspan="2">@Localizer["Round"]</th>
            <th rowspan="2" class="col-result">@Localizer["Results"]</th>
            <th colspan="2">@Localizer["WinningOptions"]</th>
        </tr>
        <tr>
            <th>@Localizer["Half Time"]</th>
            <th>@Localizer["Full Time"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>