@inject IStringLocalizer<RoundResultViewModel> Localizer

<table class="table table-bordered table-vip-se-die-war sticky-table" style="width:100%">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th class="col-result">@Localizer["Player"]</th>
            <th class="col-result">@Localizer["Banker"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>