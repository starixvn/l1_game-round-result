@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer
@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer


<table class="table table-bordered sticky-table table-dragon-tiger bandar-qiuqiu-table" style="width:100%">
    <thead>
        <tr>
            <th class="col-date">@RoundResultLocalizer["Date"]</th>
            <th>@CommonLocalizer["Round"]</th>
            <th class="col-result" style="min-width: 350px;">@CommonLocalizer["Result"] </th>
            <th>@RoundResultLocalizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>