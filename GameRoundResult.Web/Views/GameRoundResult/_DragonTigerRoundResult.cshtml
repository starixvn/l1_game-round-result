@inject IStringLocalizer<RoundResultViewModel> Localizer

<table class="table table-bordered sticky-table table-dragon-tiger" style="width:100%">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Results"] (@Localizer["Dragon"] | @Localizer["Tiger"])</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>