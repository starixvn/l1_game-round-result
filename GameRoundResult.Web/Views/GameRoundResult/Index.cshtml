@inject IJsonStringLocalizer<GameRoundResultViewModel> Localizer

@model GameRoundResultViewModel

@{
    ViewData["Title"] = Localizer["GameRoundResult"];
}

@section Styles {
    <environment include="Development">
        <link href="~/lib/data-tables/datatables.css" rel="stylesheet" />
        <link href="~/lib/flatpickr/dist/flatpickr.css" rel="stylesheet" />
        <link href="~/scss/pages/game-round-result.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/css/pages/game-round-result.min.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}

@if (Model.EnableTolgee)
{
    <input id="tolgee_language" value="@Model.Language" hidden readonly />
    <input value="GameRoundResultViewModel,RoundResultViewModel,DragonTigerFight,ColorGame,GameType,BandarQiuQiu,BacBall,SabaNumber,NextBall,FootballDice,SeBall" id="tolgee_namespace" readonly hidden />
}

<div class="header">
    <h1 class="page-title">@Localizer["GameRoundResult"]</h1>
</div>
<div class="note"><span class="bold">@Localizer["Note"]:</span> @Localizer["NoteDetail"]</div>

<form data-ajax="true" data-ajax-method="GET" asp-action="GetRoundResult" data-ajax-mode="replace"
      data-ajax-update="#round-result" data-ajax-loading="#overlay"
      data-ajax-success="gameRoundResult.onGetRoundResultSuccess"
      method="get"
      class="filter">
    <input type="hidden" asp-for="UserTimeZone" />
    <select asp-for="GameType" asp-items="Model.GameTypes" class="form-control"></select>
    <input type="number" asp-for="RoundId" placeholder="@Localizer["RoundId"]" class="form-control" />
    <input type="date" asp-for="Date" class="form-control" />
    <button class="btn-submit">@Localizer["Search"]</button>
</form>

<div id="round-result">
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/data-tables/datatables.js"></script>
        <script src="~/lib/flatpickr/dist/flatpickr.js"></script>
        <script src="~/js/game-round-result.js" asp-append-version="true"></script>
        @if (Model.EnableTolgee)
        {
            <script src="~/lib/tolgee/index.js"></script>
            <script src="~/js/tolgee.js" asp-append-version="true"></script>
        }
    </environment>
    <environment exclude="Development">
        <script src="~/js/game-round-result.min.js" asp-append-version="true"></script>
        @if (Model.EnableTolgee)
        {
            <script src="~/lib/tolgee/index.js"></script>
            <script src="~/js/tolgee.js" asp-append-version="true"></script>
        }
    </environment>
}