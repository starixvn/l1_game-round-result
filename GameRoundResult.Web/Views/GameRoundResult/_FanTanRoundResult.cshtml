@inject IStringLocalizer<RoundResultViewModel> Localizer

<table class="table table-bordered sticky-table fan-tan-result" style="width:100%">
    <thead>
        <tr>
            <th class="col-date" rowspan="2">@Localizer["Date"]</th>
            <th rowspan="2">@Localizer["Round"]</th>
            <th class="col-result" rowspan="2">@Localizer["Result"]</th>
            <th colspan="4">@Localizer["WinningOption"]</th>
        </tr>
        <tr>
            <th>@Localizer["Fan"]</th>
            <th>@Localizer["Odd"]/@Localizer["Even"]</th>
            <th>@Localizer["Kwok"]</th>
            <th>@Localizer["Chun"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>