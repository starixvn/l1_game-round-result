@using GameRoundResult.Web.Models.GameTicket
@using GameRoundResult.Core.Database.Entities
@using System.Globalization
@using System.Linq
@using System.Collections.Generic
@model GoldAndDragonTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<GoldAndDragonTicketViewModel> Localizer

@{
    var tumbles = Model.Bet?.SettlementResult?.Tumbles?.ToList() ?? new List<BaseCascadingClusterTumble>();
    var tumbleIndex = 0;
}

@foreach (var tumble in tumbles)
{
        var nextTumble = tumbles[tumbleIndex + 1 < tumbles.Count ? tumbleIndex + 1 : tumbleIndex];
        var previousSymbols = nextTumble?.Symbols;
        var payoutList = (previousSymbols ?? Enumerable.Empty<SymbolsInfo>())
            .Where(s => s.Win > 0)
            .ToList();
        var triggeredStage = nextTumble?.TriggeredStage;
        var triggeredPosition = nextTumble?.TriggeredPositions;
        var title = tumbleIndex == 0 ? Localizer["InitialSpin"] : $"{Localizer["Tumble"]} {tumbleIndex}";
        <div class="tumble-section mb-4" data-tumble-index="@tumbleIndex">
            <div class="tumble-title p-2 text-center">
                <strong>@title</strong>
            </div>

            <!-- Reels Grid 6x6 -->
            <div class="reels-grid border rounded-bottom p-3">
                <div class="rage-meter mb-2">
                    <div class="rage-scale">
                        <span class="rage-label">RAGE</span>
                        <span class="mark" style="left: 18.75%">15</span>
                        <span class="mark" style="left: 37.5%">30</span>
                        <span class="mark" style="left: 62.5%">60</span>
                        <span class="mark" style="left: 100%">90</span>
                    </div>
                    <div class="rage-row">
                        <div class="rage-track">
                            <div class="rage-fill" style="width: @((nextTumble.RageMeter / 80m * 100))%">
                                <span class="rage-value">@nextTumble.RageMeter</span>
                            </div>
                            <div class="rage-ticks">
                                <span style="left: 18.75%"></span>
                                <span style="left: 37.5%"></span>
                                <span style="left: 62.5%"></span>
                                <span style="left: 100%"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_GoldAndDragonGrid", (tumble.Reels, tumble.ReelMultipliers, previousSymbols, triggeredPosition))

                @if (payoutList.Any())
                {
                    <!-- Payout Info (uses previous tumble's symbols) -->
                    <div class="payout-section mt-3 text-left">
                        <div class="payout-title mb-2">
                            <span>@Localizer["Payout"]</span>
                        </div>
                        @foreach (var symbol in payoutList)
                        {
                            var basePayoutValue = symbol.Multiplier > 0 ? (symbol.Win / symbol.Multiplier) : symbol.Win;
                            var tooltipText = $"(Payout x Dragon Wound Multipliers)\n{basePayoutValue.ToString("F2", CultureInfo.InvariantCulture)} x {symbol.Multiplier}";

                            <div class="payout-item d-flex justify-content-between align-items-center p-2 bg-light rounded mb-1">
                                <div class="d-flex align-items-center">
                                    <span class="symbol-icon" style="background: @GetSymbolColor(symbol.Symbol)">@symbol.Symbol</span>
                                    <span class="ml-2">x @symbol.Count @(symbol.Multiplier > 1 ? $"x {symbol.Multiplier}" : "")</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="mr-2">@symbol.Win.ToString("F2")</span>
                                    <span class="payout-info-icon" title="@tooltipText">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                                            <text x="8" y="11" text-anchor="middle" font-size="10" font-weight="bold" fill="currentColor">i</text>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- No winning combination + optional Rage Meter bonus label -->
                    <div class="payout-section mt-3 text-left">
                        <div class="payout-title mb-2">
                            <span>@Localizer["Payout"]</span>
                        </div>
                        <div class="payout-message p-2 bg-light rounded mb-1 text-muted">@Localizer["NoWinningCombination"]</div>
                        @if (triggeredStage.HasValue)
                        {
                            <div class="payout-message p-2 bg-light rounded d-flex align-items-center justify-content-center">
                                <span class="mr-2">&#128227;</span>
                                <span>@Localizer["ThunderousRoarBonus"]</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        tumbleIndex++;
}

@functions {
    private static readonly IReadOnlyDictionary<int, string> SymbolColorMap = new Dictionary<int, string>
    {
        { 1, "#2E8B57" }, // SeaGreen
        { 2, "#4169E1" }, // RoyalBlue
        { 3, "#8A2BE2" }, // BlueViolet
        { 4, "#DC143C" }, // Crimson
        { 5, "#FF8C00" }, // DarkOrange
        { 6, "#32CD32" }, // LimeGreen
        { 7, "#FFD700" }, // Gold
        { 8, "#FF1493" }, // DeepPink
        { 9, "#00CED1" }, // DarkTurquoise
        { 0, "#808080" }  // Gray (empty)
    };

    private static string GetSymbolColor(int symbolId)
    {
        return SymbolColorMap.TryGetValue(symbolId, out var color)
            ? color
            : "#696969"; // DimGray (default)
    }
}

@* styles moved to wwwroot/scss/pages/gold-and-dragon.scss *@
