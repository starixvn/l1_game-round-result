@model Marbles158TicketViewModel
@using GameRoundResult.Core.Constants

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<Marbles158TicketViewModel> Localizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer


@{
    ViewBag.Localizer = Localizer;
    ViewBag.TolgeeNamespace = "GameTicketResultViewModel,Common,RoundResultViewModel,Marbles158";
    ViewBag.HeaderText = "header_match";
    ViewBag.ShowingBetDetail = Model.BetLogs.Any() && Model.RoundResult != null;
    ViewBag.IsUsingMarbleOdds = true;
}

@await Html.PartialAsync("~/Views/BetHistory/shared/_GameMarbleTicketResultPartial.cshtml", Model)
@await Html.PartialAsync("~/Views/BetHistory/shared/_GameMarbleTicketPartialLandScape.cshtml", Model)
@await Html.PartialAsync("~/Views/BetHistory/shared/_GameMarbleTicketPartialPortrait.cshtml", Model)
