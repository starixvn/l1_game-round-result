@using Microsoft.Extensions.Localization
@model HiLoTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<HiLoTicketViewModel> HiLoLocalizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,HiLoTicketViewModel" id="tolgee_namespace" readonly hidden/>
}
<table class="table table-bordered table-hilo">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@HiLoLocalizer["Turn"]</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@HiLoLocalizer["Base Card"]</th>
            <th>@HiLoLocalizer["Result Card"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
            <th>@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                </td>
                <td rowspan="@(Model.BetLogs.Count() + 2)">
                    @Model.RoundResult.RoundId
                </td>
                <td colspan="4">@HiLoLocalizer["Start Round"]</td>
                <td class="bold text-right text-blue">@Model.RoundResult.Amount.Format()</td>
                <td></td>
            </tr>
            @foreach (var betLog in Model.BetLogs)
            {
                <tr>
                    <td>
                        @betLog.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                        <br />
                        @betLog.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td>@betLog.Order</td>
                    <td>@HiLoLocalizer[betLog.Choice]</td>
                    @foreach (var card in betLog.Cards)
                    {
                        <td class="blackjack-result">
                            <div class="cards">

                                <div class="card card-type-@card.Suit">
                                    <span>@card.Rank</span>
                                    <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                </div>
                            </div>
                        </td>
                    }
                    <td class="text-right bold">@betLog.Amount.Format()</td>
                    <td class="text-right bold">@betLog.Betwin.Format()</td>
                </tr>
            }
            <tr>
                <td>
                    @Model.RoundResult.EndTime?.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                    <br />
                    @Model.RoundResult.EndTime?.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                </td>

                <td colspan="4">@HiLoLocalizer["End Round"]</td>
                <td></td>
                <td class="bold text-right text-blue">
                    @if (Model.RoundResult.Paid)
                    {
                        @(Model.RoundResult.Betwin.Format())
                    }
                    else
                    {
                        @(HiLoLocalizer["Running"])
                    }
                </td>
            </tr>
            <tr class="total">
                <td class="bold text-right" colspan="6">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right"></td>
                @if (Model.RoundResult.Paid)
                {
                    <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">

                        @(Model.WinLoss.Format())
                    </td>
                }
                else
                {
                    <td class="bold">

                        @("-")
                    </td>
                }
            </tr>
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>