@model SeDieMultiplayerTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<SeDieMultiplayerTicketViewModel> Localizer

@{
    // Set up ViewBag data for the shared partial view
    ViewBag.EnableTolgee = Model.EnableTolgee;
    ViewBag.TolgeeNamespace = "GameTicketResultViewModel,Common,SeDieMultiplayerTicketViewModel";
    ViewBag.TimeOffsetString = Model.TimeOffsetString;
    ViewBag.RoundResult = Model.RoundResult;
    ViewBag.Bet = Model.Bet;
    ViewBag.TotalBet = Model.TotalBet;
    ViewBag.TotalWin = Model.TotalWin;
    ViewBag.WinLoss = Model.WinLoss;
    ViewBag.CommonLocalizer = CommonLocalizer;
    ViewBag.GameLocalizer = Localizer;
}

@await Html.PartialAsync("~/Views/BetHistory/_SeDieOriginalGamesTicketBase.cshtml")
