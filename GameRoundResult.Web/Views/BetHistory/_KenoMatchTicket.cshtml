@model KenoMatchTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<KenoMatchTicketViewModel> Localizer

@{
    var betChoiceMapper = new Dictionary<string, string>
{
        { "fhBlue", Localizer["Team Blue"] },
        { "fhRed", Localizer["Team Red"] },
        { "fhOver", Localizer["Over"] },
        { "fhUnder", Localizer["Under"] },
        { "fhOdd", Localizer["Odd"] },
        { "fhEven", Localizer["Even"] },
        { "ftBlue", Localizer["Team Blue"] },
        { "ftRed", Localizer["Team Red"] },
        { "ftOver", Localizer["Over"] },
        { "ftUnder", Localizer["Under"] },
        { "ftOdd", Localizer["Odd"] },
        { "ftEven", Localizer["Even"] },
        { "liveFTBlue", Localizer["Team Blue"] },
        { "liveFTRed", Localizer["Team Red"] },
        { "liveFTOver", Localizer["Over"] },
        { "liveFTUnder", Localizer["Under"] },
        { "liveFTOdd", Localizer["Odd"] },
        { "liveFTEven", Localizer["Even"] },
    };

    var betTypeMapper = new Dictionary<string, string>
{
        { "fhBlue", Localizer["First Half Team Blue/Team Red"] },
        { "fhRed", Localizer["First Half Team Blue/Team Red"] },
        { "fhOver", Localizer["First Half Over/Under"] },
        { "fhUnder", Localizer["First Half Over/Under"] },
        { "fhOdd", Localizer["First Half Even/Odd"] },
        { "fhEven", Localizer["First Half Even/Odd"] },
        { "ftBlue", Localizer["Full Time Team Blue/Team Red"] },
        { "ftRed", Localizer["Full Time Team Blue/Team Red"] },
        { "ftOver", Localizer["Full Time Over/Under"] },
        { "ftUnder", Localizer["Full Time Over/Under"] },
        { "ftOdd", Localizer["Full Time Even/Odd"] },
        { "ftEven", Localizer["Full Time Even/Odd"] },
        { "liveFTBlue", Localizer["Full Time Team Blue/Team Red (Live)"] },
        { "liveFTRed", Localizer["Full Time Team Blue/Team Red (Live)"] },
        { "liveFTOver", Localizer["Full Time Over/Under (Live)"] },
        { "liveFTUnder", Localizer["Full Time Over/Under (Live)"] },
        { "liveFTOdd", Localizer["Full Time Even/Odd (Live)"] },
        { "liveFTEven", Localizer["Full Time Even/Odd (Live)"] },
    };
}

<table class="table table-bordered table-keno-match">
    <thead>
        <tr>
            <th rowspan="2" class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th rowspan="2" class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th rowspan="2">@CommonLocalizer["Result"]</th>
            <th colspan="2">@CommonLocalizer["WinningOptions"]</th>
        </tr>
        <tr>
            <th>@Localizer["First Half"]</th>
            <th>@Localizer["Full Time"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null && Model.RoundResult.Settled)
        {
            var htResult = Model.RoundResult.HalfTime;
            var ftResult = Model.RoundResult.FullTime;
            var htSettlementResult = Model.RoundResult.HalfTime.SettlementResult;
            var ftSettlementResult = Model.RoundResult.FullTime.SettlementResult;
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr class="bold">
                                <td>@Localizer["Team Blue"]</td>
                                <td>@Localizer["Team Red"]</td>
                            </tr>
                            <tr>
                                <td class="bold" colspan="2">@Localizer["First Half"]</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="number-list">
                                        @foreach (var number in htResult.Result.Blue)
                                        {
                                            <span class="number blue">@number</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="number-list">
                                        @foreach (var number in htResult.Result.Red)
                                        {
                                            <span class="number red">@number</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">@Localizer["Team Blue"] @htResult.Result.Blue.Sum() - @Localizer["Total"] @htResult.Total - @Localizer["Team Red"] @htResult.Result.Red.Sum()</td>
                            </tr>
                            <tr>
                                <td class="bold" colspan="2">@Localizer["Full Time"]</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="number-list">
                                        @foreach (var number in Model.RoundResult.FullTime.Result.Blue)
                                        {
                                            <span class="number blue">@number</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="number-list">
                                        @foreach (var number in Model.RoundResult.FullTime.Result.Red)
                                        {
                                            <span class="number red">@number</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">@Localizer["Team Blue"] @(htResult.Result.Blue.Sum() + ftResult.Result.Blue.Sum()) - @Localizer["Total"] @ftResult.Total - @Localizer["Team Red"] @(htResult.Result.Red.Sum() + ftResult.Result.Red.Sum())</td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td>
                    <div>
                        @if (htSettlementResult.Blue)
                        {
                            @Localizer["Team Blue"]
                        }
                        else
                        {
                            if (htSettlementResult.Red)
                            {
                                @Localizer["Team Red"]
                            }
                            else
                            {
                                @Localizer["Tie"]

                            }
                        }

                    </div>

                    <div>
                        @if (htSettlementResult.Over)
                        {
                            @Localizer["Over"]
                        }
                        else
                        {
                            @Localizer["Under"]
                        }
                    </div>
                    <div>
                        @if (htSettlementResult.Odd)
                        {
                            @Localizer["Odd"]
                        }
                        else
                        {
                            @Localizer["Even"]
                        }
                    </div>
                </td>

                <td>
                    <div>
                        @if (ftSettlementResult.Blue)
                        {
                            @Localizer["Team Blue"]
                        }
                        else
                        {
                            if (ftSettlementResult.Red)
                            {
                                @Localizer["Team Red"]
                            }
                            else
                            {
                                @Localizer["Tie"]
                            }
                        }

                    </div>

                    <div>
                        @if (ftSettlementResult.Over)
                        {
                            @Localizer["Over"]
                        }
                        else
                        {
                            @Localizer["Under"]
                        }
                    </div>
                    <div>
                        @if (ftSettlementResult.Odd)
                        {
                            @Localizer["Odd"]
                        }
                        else
                        {
                            @Localizer["Even"]
                        }
                    </div>

                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["BetTime"] (@Model.TimeOffsetString)</th>
            <th>@CommonLocalizer["BetType"]</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["Odds"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
            <th>@CommonLocalizer["Refund"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null && Model.RoundResult.Settled)
        {
            foreach (var bet in Model.Bets)
            {
                var htSettlementResult = Model.RoundResult.HalfTime.SettlementResult;
                var ftSettlementResult = Model.RoundResult.FullTime.SettlementResult; var settlmentResultMapper = new Dictionary<string, bool>
            {
                { "fhBlue", htSettlementResult.Blue },
                { "fhRed", htSettlementResult.Red },
                { "fhOver", htSettlementResult.Over},
                { "fhUnder", htSettlementResult.Under },
                { "fhOdd", htSettlementResult.Odd},
                { "fhEven", htSettlementResult.Even },
                { "ftBlue", ftSettlementResult.Blue },
                { "ftRed", ftSettlementResult.Red },
                { "ftOver", ftSettlementResult.Over},
                { "ftUnder", ftSettlementResult.Under },
                { "ftOdd", ftSettlementResult.Odd},
                { "ftEven", ftSettlementResult.Even },
                { "liveFTBlue", ftSettlementResult.Blue },
                { "liveFTRed", ftSettlementResult.Red },
                { "liveFTOver", ftSettlementResult.Over},
                { "liveFTUnder", ftSettlementResult.Under },
                { "liveFTOdd", ftSettlementResult.Odd},
                { "liveFTEven", ftSettlementResult.Even },
            };

                var settlmentResultRefund = new Dictionary<string, KenoMatchPeriodSettlementResultViewModel>
{
                { "fhBlue", htSettlementResult },
                { "fhRed", htSettlementResult },
                { "ftBlue", ftSettlementResult },
                { "ftRed", ftSettlementResult },
                { "liveFTBlue", ftSettlementResult },
                { "liveFTRed", ftSettlementResult },
            };

                var cssClass = settlmentResultMapper[bet.Choice] ? "text-blue bold" : string.Empty;
                var choiceOdds = Model.RoundResult.Odds[bet.Choice];
                <tr>
                    <td>
                        @bet.Time.ToString(ViewFormat.TicketDateFormat)
                        <br />
                        @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td class="@cssClass">
                        @betTypeMapper[bet.Choice]
                    </td>
                    <td class="@cssClass">
                        @betChoiceMapper[bet.Choice]
                    </td>
                    <td class="@cssClass">
                        @choiceOdds.Format()
                    </td>
                    <td class="text-right @cssClass">
                        @bet.Amount.Format()
                    </td>
                    <td class="text-right @cssClass">
                        @if (settlmentResultRefund.ContainsKey(bet.Choice))
                        {
                            @bet.GetRefund(settlmentResultRefund[bet.Choice]).Format()
                        }
                        else
                        {
                            @(0)
                        }
                    </td>
                </tr>
            }

            <tr>
                <td colspan="4" class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
                <td class="text-right">@Model.Refund.Format()</td>
            </tr>
            <tr>
                <td colspan="4" class="text-right">@CommonLocalizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalBetWin.Format()</td>
                <td></td>
            </tr>
            <tr class="total">
                <td colspan="4" class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
                <td></td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>