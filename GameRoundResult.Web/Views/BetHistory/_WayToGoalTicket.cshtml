@model SlotGameTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SlotGameTicketViewModel> Localizer

@{
    var roundResult = Model.RoundResult;
}

<table class="table table-bordered table-way-to-goal">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (roundResult != null)
        {
            <tr>
                <td>
                    @roundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @roundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>
                    @roundResult.RoundId
                    <br />
                    <div>@(roundResult.FreeSpin ? $"({Localizer["Free spin"]})" : string.Empty)</div>
                </td>
                <td>
                    <table class="table-paylines">
                        <tbody>
                            @{
                                var array = roundResult.GetFormatResults();
                                for (var row = 0; row < array.GetLength(0); row++)
                                {
                                    <tr>
                                        @for (var column = 0; column < array.GetLength(1); column++)
                                        {
                                            <td><img class="symbol" src="~/scss/images/way-to-goal/@(array[row,column]).png" /></td>
                                        }
                                    </tr>

                                }
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-way-to-goal">
    <thead>
        <tr>
            <th>@Localizer["Payline"]</th>
            <th>@Localizer["Symbol"]</th>
            <th>@Localizer["NoSymbol"]</th>
            <th>@Localizer["Odds"]</th>
            <th>@Localizer["Stake"]</th>
            <th>@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (roundResult != null)
        {
            if (roundResult.SettlementResult.Jackpot != null)
            {
                <tr>
                    <td><img class="payline" src="~/scss/images/way-to-goal/dong@(roundResult.SettlementResult.Jackpot.WinningLine + 1).png" /></td>
                    <td><img class="symbol" src="~/scss/images/way-to-goal/10.png" /></td>
                    <td>5</td>
                    <td>@Localizer["Jackpot"]</td>
                    <td class="text-right">@roundResult.Bet.Format()</td>
                    <td class="text-right">@roundResult.SettlementResult.Jackpot.WinningAmount.Format()</td>
                </tr>
            }
            foreach (var payline in roundResult.Paylines.Where(x => roundResult.SettlementResult.WinningPaylines.Any(y => y.Payline == x)))
            {
                var winningPayline = roundResult.SettlementResult.WinningPaylines.FirstOrDefault(x => x.Payline == payline);

                <tr>
                    <td><img class="payline" src="~/scss/images/way-to-goal/dong@(payline + 1).png" /></td>
                    <td><img class="symbol" src="~/scss/images/way-to-goal/@(winningPayline.Symbol).png" /></td>
                    <td>@winningPayline.Count</td>
                    <td>x@(winningPayline.Odds)</td>
                    <td class="text-right">@roundResult.Bet.Format()</td>
                    <td class="text-right">@((roundResult.Bet * winningPayline.Odds).Format())</td>
                </tr>
            }

            if (roundResult.SettlementResult.Bonus.Odds > 0)
            {
                <tr>
                    <td></td>
                    <td><img class="symbol" src="~/scss/images/way-to-goal/8.png" /></td>
                    <td>@roundResult.SettlementResult.Bonus.Count</td>
                    <td>@roundResult.SettlementResult.Bonus.Odds @Localizer["Bonus"]</td>
                    <td>-</td>
                    <td class="text-right">@roundResult.BonusChests.Where(x => x.Picked).Sum(x => x.Amount).Format()</td>
                </tr>
            }

            if (roundResult.SettlementResult.FreeSpins.Odds > 0)
            {
                <tr>
                    <td></td>
                    <td><img class="symbol" src="~/scss/images/way-to-goal/7.png" /></td>
                    <td>@roundResult.SettlementResult.FreeSpins.Count</td>
                    <td>@roundResult.SettlementResult.FreeSpins.Odds @Localizer["Free spins"]</td>
                    <td>-</td>
                    <td>-</td>
                </tr>
            }

            foreach (var payline in roundResult.Paylines.Where(x => !roundResult.SettlementResult.WinningPaylines.Any(y => y.Payline == x) && x != roundResult.SettlementResult.Jackpot?.WinningLine))
            {

                <tr>
                    <td><img class="payline" src="~/scss/images/way-to-goal/dong@(payline + 1).png" /></td>
                    <td>-</td>
                    <td>-</td>
                    <td>-</td>
                    <td class="text-right">@roundResult.Bet.Format()</td>
                    <td class="text-right">0</td>
                </tr>
            }

            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td class="bold text-right">@CommonLocalizer["Total"]</td>
                <td class="bold text-right">@(roundResult.FreeSpin ? "0" : roundResult.TotalAmount.Format())</td>
                <td class="bold text-right">@Model.BetWin.Format()</td>
            </tr>
            <tr class="total">
                <td></td>
                <td></td>
                <td></td>
                <td class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td></td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>