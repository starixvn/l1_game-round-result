@model MarbleFootball2TicketViewModel
@using GameRoundResult.Core.Constants

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<MarbleFootball2TicketViewModel> Localizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer


@{
    ViewBag.Localizer = Localizer;
    ViewBag.TolgeeNamespace = "GameTicketResultViewModel,Common,RoundResultViewModel,MarbleFootball2,MarbleFootball";
    ViewBag.HeaderText = "header_match";
    ViewBag.ShowingBetDetail = Model.BetLogs.Any() && Model.RoundResult != null;
}

@await Html.PartialAsync("shared/_GameMarbleTicketResultPartial", Model)
@await Html.PartialAsync("shared/_GameMarbleTicketPartialLandScape", Model)
@await Html.PartialAsync("shared/_GameMarbleTicketPartialPortrait", Model)
