@using GameRoundResult.Core.Database.Entities
@using GameRoundResult.Web.Models.GameTicket
@using System.Globalization
@using MongoDB.Driver.Linq
@model GoldAndDragonTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<GoldAndDragonTicketViewModel> Localizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,GoldAndDragonTicketViewModel" id="tolgee_namespace" readonly hidden />
}

<div class="ticket-container">
    <!-- Sticky Ticket Header -->
    @{
        DateTime? localTime = Model.Bet != null ? Model.Bet.Time.Add(Model.TimeZoneOffset) : (DateTime?)null;
    }
    <div class="ticket-sticky-header">
        <div class="ticket-header-top">
            <div class="ticket-title">ROUND: @Model.Bet?.RoundId</div>
        </div>
        <div class="ticket-sub">
            @if (localTime.HasValue)
            {
                <span>@localTime.Value.ToString("MM/dd/yyyy HH:mm:ss", CultureInfo.InvariantCulture)</span>
                <span class="ml-1">(@Model.TimeOffsetString)</span>
            }
        </div>
        <div class="ticket-stats">
            <div class="stat">
                <div class="stat-label">@Localizer["BetLevel"]</div>
                <div class="stat-value">@Model.Bet?.BetLevel</div>
            </div>
            <div class="stat">
                <div class="stat-label">@Localizer["CoinValue"]</div>
                <div class="stat-value">@Model.Bet?.CoinValue.ToString("F2")</div>
            </div>
            <div class="stat">
                <div class="stat-label">@CommonLocalizer["TotalBet"]</div>
                <div class="stat-value">@Model.Bet?.TotalAmount.ToString("F2")</div>
            </div>
            <div class="stat">
                <div class="stat-label">@CommonLocalizer["TotalWin"]</div>
                <div class="stat-value">@Model.Bet?.BetWin.ToString("F2")</div>
            </div>
        </div>
        @if (Model.Bet?.FreeSpin == true || Model.Bet?.BuyFreeSpin == true)
        {
            <div class="ticket-flags">
                @if (Model.Bet.FreeSpin)
                {
                    <span class="flag flag-info">@Localizer["FreeSpin"]</span>
                }
                @if (Model.Bet.BuyFreeSpin)
                {
                    <span class="flag flag-warning">@Localizer["BuyFreeSpin"]</span>
                }
            </div>
        }
    </div>

    <!-- Tumble Details -->
    @await Html.PartialAsync("_GoldAndDragonTumbleDetails", Model)
</div>