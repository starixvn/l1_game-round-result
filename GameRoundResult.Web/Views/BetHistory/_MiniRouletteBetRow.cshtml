@model MiniRouletteBetRowViewModel
@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<MiniRouletteTicketViewModel> Localizer

@{
    var bet = Model.Bet;
    var settlementResult = Model.SettlementResult;
    var rowSpan = 0;

    var dozens = new Dictionary<string, string>()
{
        {"1", "1-12" },
        {"2", "13-24" },
        {"3", "25-36"  }
    };

    var bigSmall = new Dictionary<string, string>()
{
        {"small", "1-18" },
        {"big", "19-36" },
    };

    var redBlackResources = new Dictionary<string, string>()
{
        {"red", "Red" },
        {"black", "Black" },
    };

    var oddEvenResource = new Dictionary<string, string>()
{
        {"odd", "Odd" },
        {"even", "Even" },
    };

    if (bet.StraightUp.Any())
    {
        rowSpan += bet.StraightUp.Count;
    }

    if (bet.Split.Any())
    {
        rowSpan += bet.Split.Count;
    }

    if (bet.Street.Any())
    {
        rowSpan += bet.Street.Count;
    }

    if (bet.Triangle.Any())
    {
        rowSpan += bet.Triangle.Count;
    }

    if (bet.Corner.Any())
    {
        rowSpan += bet.Corner.Count;
    }

    if (bet.FourNumbers.Any())
    {
        rowSpan += bet.FourNumbers.Count;
    }

    if (bet.Line.Any())
    {
        rowSpan += bet.Line.Count;
    }

    if (bet.Column.Any())
    {
        rowSpan += bet.Column.Count;
    }

    if (bet.Dozen.Any())
    {
        rowSpan += bet.Dozen.Count;
    }

    if (bet.RedBlack.Any())
    {
        rowSpan += bet.RedBlack.Count;
    }

    if (bet.OddEven.Any())
    {
        rowSpan += bet.OddEven.Count;
    }

    if (bet.BigSmall.Any())
    {
        rowSpan += bet.BigSmall.Count;
    }

    var renderDate = true;
}

@foreach (var betChoice in bet.StraightUp)
{
    var winningCssClass = settlementResult.StraightUp.Any(x => x == betChoice.Key) ? "text-blue bold" : string.Empty;

    <tr>
        @if (renderDate)
        {
            renderDate = false;
            <td rowspan="@rowSpan">
                @bet.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                <br />
                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
            </td>
        }
        <td>@Localizer["StraightUp"]</td>
        <td class="@winningCssClass">
            @betChoice.Key
        </td>
        <td class="text-right @winningCssClass">
            @Model.DisplayAmount(betChoice.Value)
        </td>
        <td class="text-right @winningCssClass">
            @foreach (var betDetail in Model.SettlementDetails)
            {
                if(betChoice.Key == "0")
                {
                    if (betDetail.ChoiceId == 37)
                    {
                        @Model.DisplayAmount(betDetail.TotalWin);
                    }
                }else
                {
                    if (betDetail.ChoiceId.ToString() == betChoice.Key)
                    {
                        @Model.DisplayAmount(betDetail.TotalWin);
                    }   
                }
            }
        </td>
    </tr>
}


@foreach (var betChoice in bet.Dozen)
{
    var winningCssClass = settlementResult.Dozen.Any(x => x == betChoice.Key) ? "text-blue bold" : string.Empty;
    var betChoiceId = betChoice.Key == "1" ? 40 :
            betChoice.Key == "2" ? 41 :
            betChoice.Key == "3" ? 42 : -1;
    <tr>
        @if (renderDate)
        {
            renderDate = false;
            <td rowspan="@rowSpan">
                @bet.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                <br />
                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
            </td>
        }
        <td>@Localizer["Dozen"]</td>
        <td class="@winningCssClass">
            @dozens[betChoice.Key]
        </td>
        <td class="text-right @winningCssClass">
            @Model.DisplayAmount(betChoice.Value)
        </td>
        <td class="text-right @winningCssClass">
            @foreach (var betDetail in Model.SettlementDetails)
            {
                if (betDetail.ChoiceId == betChoiceId)
                {
                    @Model.DisplayAmount(betDetail.TotalWin);
                }
            }
        </td>
    </tr>
}

@foreach (var betChoice in bet.RedBlack)
{
    var winningCssClass = settlementResult.RedBlack.Any(x => x == betChoice.Key) ? "text-blue bold" : string.Empty;
    var betChoiceId = betChoice.Key == "red" ? 39 :
            betChoice.Key == "black" ? 38 : -1;

    <tr>
        @if (renderDate)
        {
            renderDate = false;
            <td rowspan="@rowSpan">
                @bet.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                <br />
                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
            </td>
        }
        <td>@Localizer["RedBlack"]</td>
        <td class="@winningCssClass">
            @Localizer[redBlackResources[betChoice.Key]]
        </td>
        <td class="text-right @winningCssClass">
            @Model.DisplayAmount(betChoice.Value)
        </td>
        <td class="text-right @winningCssClass">
            @foreach (var betDetail in Model.SettlementDetails)
            {
                if (betDetail.ChoiceId == betChoiceId)
                {
                    @Model.DisplayAmount(betDetail.TotalWin);
                }
            }
        </td>
    </tr>
}


@foreach (var betChoice in bet.OddEven)
{
    var winningCssClass = settlementResult.OddEven.Any(x => x == betChoice.Key) ? "text-blue bold" : string.Empty;
    var betChoiceId = betChoice.Key == "even" ? 43 :
            betChoice.Key == "odd" ? 44 : -1;
    <tr>
        @if (renderDate)
        {
            renderDate = false;
            <td rowspan="@rowSpan">
                @bet.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                <br />
                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
            </td>
        }
        <td>@Localizer["OddEven"]</td>
        <td class="@winningCssClass">
            @CommonLocalizer[oddEvenResource[betChoice.Key]]
        </td>
        <td class="text-right @winningCssClass">
            @Model.DisplayAmount(betChoice.Value)
        </td>
        <td class="text-right @winningCssClass">
            @foreach (var betDetail in Model.SettlementDetails)
            {
                if (betDetail.ChoiceId == betChoiceId)
                {
                    @Model.DisplayAmount(betDetail.TotalWin)
                    ;
                }
            }
        </td>
    </tr>
}
