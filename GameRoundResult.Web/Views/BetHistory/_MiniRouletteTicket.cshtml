@model MiniRouletteTicketViewModel
@using GameRoundResult.Core.Constants
@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer

@{
    var resultColorCssClass = string.Empty;

    if (Model.RoundResult?.Result == 0)
    {
        resultColorCssClass = "text-green";
    }
    else
    {
        if (Roulette.RedNumbers.Any(x => x == Model.RoundResult?.Result))
        {
            resultColorCssClass = "text-red";
        }
    }
}

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,MiniRouletteTicketViewModel" id="tolgee_namespace" readonly hidden />
}

<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat, CultureInfo.InvariantCulture)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td class="bold @resultColorCssClass">
                    @Model.RoundResult.Result
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["BetTime"] (@Model.TimeOffsetString)</th>
            <th>@CommonLocalizer["BetType"]</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {
            foreach (var bet in Model.Bets)
            {
                @await Html.PartialAsync("~/Views/BetHistory/_MiniRouletteBetRow.cshtml", new MiniRouletteBetRowViewModel { Bet = bet, SettlementResult = Model.RoundResult.SettlementResult })
            }
            <tr>
                <td colspan="3" class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td colspan="3" class="text-right">@CommonLocalizer["TotalWin"]</td>
                <td class="text-right">@Model.BetWin.Format()</td>
            </tr>
            <tr class="total">
                <td colspan="3" class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>