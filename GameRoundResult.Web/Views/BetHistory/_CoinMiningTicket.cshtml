@using GameRoundResult.Web.Models.GameTicket
@model CoinMiningTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<CoinMiningTicketViewModel> Localizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,CoinMining" id="tolgee_namespace" readonly hidden/>
}
<table class="table  table-bordered table-expand table-game-bet">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th colspan="4">@Localizer["header_crash_point"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Model.Time.ToString(ViewFormat.RoundDateFormat, CultureInfo.InvariantCulture)
                <br />
                @Model.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
            </td>
            <td>@Model.Bet.RoundId</td>
            <td colspan="4">
                @Model.GetCrashPoint()
            </td>
        </tr>
    </tbody>
    <thead>
        <tr>
            <th>@Localizer["header_mining_attempts"]</th>
            <th>@CommonLocalizer["result"]</th>
            <th>@Localizer["header_multiplier"]</th>
            <th>@CommonLocalizer["stake"]</th>
            <th>@CommonLocalizer["win"]</th>
            <th>@CommonLocalizer["win_loss"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td >@Model.Bet.TapCount</td>
            <td class="@Model.WinLossRowClassName">@Localizer[Model.GetResult()]</td>
            <td class="@Model.CashOutClassName">@Model.GetMultiplier()</td>
            <td class="@Model.CashOutClassName">@Model.Bet.Amount</td>
            <td class="@Model.CashOutClassName">@Model.Bet.Betwin</td>
            <td class="@Model.WinLossRowClassName">@Model.WinLoss</td>
        </tr>
    </tbody>
</table>

<table class="table  table-bordered table-game-bet-vertical">
    <thead>
        <tr>
            <th class="text-center title">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="text-center title">@CommonLocalizer["RoundId"]</th>
            <th class="text-center title">@Localizer["header_crash_point"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="text-center title">
                @Model.Bet.Time.ToString(ViewFormat.RoundDateFormat, CultureInfo.InvariantCulture)
                <br />
                @Model.Bet.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
            </td>
            <td class="text-center title">@Model.Bet.RoundId</td>
            <td class="text-center title bold">
                @Model.GetCrashPoint()
            </td>
        </tr>
    </tbody>   
    
    <tbody>
        <tr>
            <td class="text-left bold" colspan="2">
                @Localizer["header_mining_attempts"]
            </td>
            <td class="text-right">
                @Model.Bet.TapCount
            </td>
        </tr>
        <tr>
            <td class="text-left bold" colspan="2">
                @CommonLocalizer["result"]
            </td>
            <td class="text-right @Model.WinLossRowClassName">@Localizer[Model.GetResult()]</td>
        </tr>
        <tr>
            <td class="text-left bold" colspan="2">
                @Localizer["header_multiplier"]
            </td>
            <td class="text-right @Model.CashOutClassName">@Model.GetMultiplier()</td>
        </tr>
        <tr>
            <td class="text-left bold" colspan="2">
                @CommonLocalizer["stake"]
            </td>
            <td class="text-right @Model.CashOutClassName">
                @Model.Bet.Amount
            </td>
        </tr>
        <tr>
            <td class="text-left bold" colspan="2">
                @CommonLocalizer["win"]
            </td>
            <td class="text-right @Model.CashOutClassName">@Model.GetBetWin()</td>
        </tr>
        <tr>
            <td class="text-left bold" colspan="2">
                @CommonLocalizer["win_loss"]
            </td>
            <td class="text-right @Model.WinLossRowClassName">@Model.WinLoss</td>
        </tr>
    </tbody>
</table>