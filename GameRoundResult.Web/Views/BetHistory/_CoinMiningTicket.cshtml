@using GameRoundResult.Web.Models.GameTicket
@model CoinMiningTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<CoinMiningTicketViewModel> Localizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,CoinMining" id="tolgee_namespace" readonly hidden/>
}

<table class="table  table-bordered table-expand">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th colspan="4">@Localizer["header_crash_point"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Model.Bet.Time.ToString(ViewFormat.RoundDateFormat, CultureInfo.InvariantCulture)
                <br />
                @Model.Bet.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
            </td>
            <td>@Model.Bet.RoundId</td>
            <td colspan="4">
                @Model.GetCrashPoint()
            </td>
        </tr>
    </tbody>
    <thead>
        <tr>
            <th>@Localizer["header_mining_attempts"]</th>
            <th>@CommonLocalizer["result"]</th>
            <th>@Localizer["header_multiplier"]</th>
            <th>@CommonLocalizer["stake"]</th>
            <th>@CommonLocalizer["win"]</th>
            <th>@CommonLocalizer["win_loss"]</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Bet.TapCount</td>
            <td>@Localizer[Model.GetResult()]</td>
            <td>@Model.GetMultiplier()</td>
            <td>@Model.Bet.Amount</td>
            <td>@Model.Bet.Betwin</td>
            <td>@Model.WinLoss</td>
        </tr>
    </tbody>
</table>