@model KaraKrusTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<KaraKrusTicketViewModel> Localizer

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,KaraKrusTicketViewModel" id="tolgee_namespace" readonly hidden />
}
@{
    var betTypes = new Dictionary<string, bool>
    {
        { "kara", true },
        { "krus", true },
        { "head1", false },
        { "head2", false },
        { "head3", false },
        { "tail3", false }
    };
}

<table class="table table-bordered table-baccarat table-baccarat-fixed">
    <thead>
        <tr>
            <th class="col-round-id col-fixed">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    <span class="sedie3-result">
                        @foreach (var chip in Model.RoundResult.HeadChips)
                        {
                            <i class="@(chip ? "dice-kara" : "dice-krus")"></i>
                        }
                        <span class="text">
                            @if (Model.RoundResult.SettlementResult.Kara)
                            {
                                @(" - " + CommonLocalizer["Kara"])
                            }
                            else
                            {
                                @(" - " + CommonLocalizer["Krus"])
                            }
                        </span>
                    </span>                  
                </td>
            </tr>
        }
        else
        {
            <tr>
               <td colspan="2" class="text-center">
                   @CommonLocalizer["NoDataAvailable"]
               </td>
            </tr>
        }   
    </tbody>
</table>

<table class="table table-bordered table-baccarat table-baccaratx-bet">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-betchoice">@CommonLocalizer["BetChoice"]</th>
            <th class="col-odds">@CommonLocalizer["Odds"]</th>
            <th class="col-stake">@CommonLocalizer["Stake"]</th>
            <th class="col-win">@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null && Model.BetLogs.Any())
        {
            @foreach (var betLog in Model.BetLogs)
            {
                var displayText = betTypes.TryGetValue(betLog.Choice, out var showText) && showText;
                var cssClass = Model.GetRowBetClass(betLog.Choice);
                <tr>
                    <td>
                        @betLog.DateDisplay @betLog.TimeDisplay
                    </td>
                    <td>
                        @if (displayText)
                        {
                            @CommonLocalizer[betLog.ChoiceKey]
                        }
                        else
                        {
                            @Html.Raw(Model.RenderChips(betLog.Choice))
                        }
                    </td>
                    <td class="@cssClass">@Model.DisplayOdds(betLog.Choice)</td>
                    <td class="text-right @cssClass">@Model.DisplayAmount(betLog.Amount)</td>
                    <td class="text-right @cssClass">@Model.DisplayAmount(Model.GetBetLogWin(betLog))</td>
                </tr>
            }
           
            <tr class="total">
                <td class="text-right" colspan="3">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.DisplayTotalBet</td>
                <td class="text-right">@Model.DisplayBetWin</td>
            </tr>
            <tr class="total">
                <td class="bold text-right" colspan="3">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @Model.WinLossRowClassName" colspan="2">@Model.DisplayWinLoss</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-baccarat table-baccaratx-bet-vertical">
    <tbody>
        @if (Model.RoundResult != null && Model.BetLogs.Any())
        {
            @foreach (var betLog in Model.BetLogs)
            {
                var displayText = betTypes.TryGetValue(betLog.Choice, out var showText) && showText;
                var cssClass = Model.GetRowBetClass(betLog.Choice);
                <tr>
                    <td class="text-left title"> @CommonLocalizer["Time"] (@Model.TimeOffsetString)</td>
                    <td class="text-right">@FormatHelper.RoundDateTimeFormat(betLog.Time)</td>
                </tr>
                <tr>
                    <td class="text-left">@CommonLocalizer["BetChoice"]</td>
                    <td class="text-right">
                        @if (displayText)
                        {
                            @CommonLocalizer[betLog.ChoiceKey]
                        }
                        else
                        {
                            @Html.Raw(Model.RenderChips(betLog.Choice))
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-left">@CommonLocalizer["Odds"]</td>
                    <td class="text-right @cssClass">@Model.DisplayOdds(betLog.Choice)</td>
                </tr>
                <tr>
                    <td class="text-left">@CommonLocalizer["Stake"]</td>
                    <td class="text-right @cssClass">@Model.DisplayAmount(betLog.Amount)</td>
                </tr>
                <tr>
                    <td class="text-left">@CommonLocalizer["Win"]</td>
                    <td class="text-right @cssClass">@Model.DisplayAmount(Model.GetBetLogWin(betLog))</td>
                </tr>
                <tr class="line-break"></tr>
            }

            <tr class="total">
                <td class="text-right">
                    @CommonLocalizer["Stake"]
                </td>
                <td class="text-right">@Model.DisplayTotalBet</td>
            </tr>
            <tr class="total">
                <td class="text-right">                
                    @CommonLocalizer["TotalWin"]
                </td>
                <td class="text-right">@Model.DisplayBetWin</td>
            </tr>
            <tr class="total">
                <td class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @Model.WinLossRowClassName">
                    @Model.DisplayWinLoss
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>
