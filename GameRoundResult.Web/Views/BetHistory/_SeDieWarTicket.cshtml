@model VipSeDieWarTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<VipSeDieWarTicketViewModel> Localizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer

@{
    var betChoiceDictionary = new Dictionary<string, string>
{
        { "odd", Localizer["TotalOdd"] },
        { "even", Localizer["TotalEven"] },
        { "player", Localizer["Player"] },
        { "banker", Localizer["Banker"] },
        { "tie", CommonLocalizer["Tie"] },
        { "playerOdd", Localizer["PlayerOdd"] },
        { "playerEven", Localizer["PlayerEven"] },
        { "playerRed4", Localizer["PlayerRed4"] },
        { "playerRed3", Localizer["PlayerRed3"] },
        { "playerWhite3", Localizer["PlayerRed1"] },
        { "playerWhite4", Localizer["PlayerWhite4"] },
        { "bankerOdd", Localizer["BankerOdd"] },
        { "bankerEven", Localizer["BankerEven"] },
        { "bankerRed4", Localizer["BankerRed4"] },
        { "bankerRed3", Localizer["BankerRed3"] },
        { "bankerWhite3", Localizer["BankerRed1"] },
        { "bankerWhite4", Localizer["BankerWhite4"] },

    };
}

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,GameTicketViewModel,VipSeDieWarTicketViewModel,RoundResultViewModel" id="tolgee_namespace" readonly hidden/>
}
<table class="table table-bordered table-vip-se-die-war">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@Localizer["Player"]</th>
            <th>@Localizer["Banker"]</th>
            <th>@CommonLocalizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    @foreach (var chip in Model.RoundResult.PlayerChips)
                    {
                        <i class="@(chip ? "red-chip" : "white-chip")"></i>
                    }
                </td>
                <td>
                    @foreach (var chip in Model.RoundResult.BankerChips)
                    {
                        <i class="@(chip ? "red-chip" : "white-chip")"></i>
                    }
                </td>
                <td>@Model.RoundResult.GetResultContent(RoundResultLocalizer)</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@CommonLocalizer["BetTime"] (@Model.TimeOffsetString)</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any())
        {
            @foreach (var bet in Model.Bets)
            {
                <tr>
                    <td>
                        @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                        <br />
                        @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td class="@(Model.RoundResult.SettlementResult[bet.Choice] ? "text-blue bold" : string.Empty)">
                        @betChoiceDictionary[bet.Choice]
                    </td>
                    <td class="text-right @(Model.RoundResult.SettlementResult[bet.Choice] ? "text-blue bold" : string.Empty)">@bet.Amount.Format()</td>
                </tr>
            }
            <tr>
                <td></td>
                <td class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td></td>
                <td class="text-right">@CommonLocalizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalBetWin.Format()</td>
            </tr>
            <tr class="total">
                <td></td>
                <td class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>