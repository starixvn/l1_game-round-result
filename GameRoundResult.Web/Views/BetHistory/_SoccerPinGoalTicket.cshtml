@model SoccerPinGoalTicketViewModel
@using GameRoundResult.Core.Constants

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<SoccerPinGoalTicketViewModel> Localizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer


@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,RoundResultViewModel,SoccerPinGoal" id="tolgee_namespace" readonly
        hidden />
}

<table class="table table-bordered table-baccarat table-baccarat-fixed">
    <thead>
        <tr>
            <th class="col-round-id col-fixed">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    <div>
                        <span style="margin-top: 5px; margin-bottom: 5px;">
                            @Html.Raw(@Model.RoundResult.GetFormattedResult(RoundResultLocalizer))
                        </span>
                    </div>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>


@{
    ViewBag.Localizer = Localizer;
    ViewBag.TolgeeNamespace = "GameTicketResultViewModel,Common,RoundResultViewModel,SoccerPinGoal";
    ViewBag.HeaderText = "roundId";
    ViewBag.ShowingBetDetail = Model.BetLogs.Any() && Model.RoundResult != null;
}

@await Html.PartialAsync("shared/_GameMarbleTicketPartialLandScape", Model)
@await Html.PartialAsync("shared/_GameMarbleTicketPartialPortrait", Model)
