@model SicBoTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> Localizer
@inject IJsonStringLocalizer<SicBoTicketViewModel> SicBoLocalizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer

@{
    var betChoiceDisplayDictionary = new Dictionary<string, string>
{
        { "specific1", "1" },
        { "specific2", "2" },
        { "specific3", "3" },
        { "specific4", "4" },
        { "specific5", "5" },
        { "specific6", "6" },
        { "total4", "4" },
        { "total5", "5" },
        { "total6", "6" },
        { "total7", "7" },
        { "total8", "8" },
        { "total9", "9" },
        { "total10", "10" },
        { "total11", "11" },
        { "total12", "12" },
        { "total13", "13" },
        { "total14", "14" },
        { "total15", "15" },
        { "total16", "16" },
        { "total17", "17" },
        { "big", Localizer["Big"] },
        { "small", Localizer["Small"] },
        { "anyTriple", SicBoLocalizer["AnyTriple"] },
    };

    var betTypeDisplayDictionary = new Dictionary<string, string>
{
        { "specific1", SicBoLocalizer["Specific"] },
        { "specific2", SicBoLocalizer["Specific"] },
        { "specific3", SicBoLocalizer["Specific"] },
        { "specific4", SicBoLocalizer["Specific"] },
        { "specific5", SicBoLocalizer["Specific"] },
        { "specific6", SicBoLocalizer["Specific"] },
        { "total4", SicBoLocalizer["Total"] },
        { "total5", SicBoLocalizer["Total"] },
        { "total6", SicBoLocalizer["Total"] },
        { "total7", SicBoLocalizer["Total"] },
        { "total8", SicBoLocalizer["Total"] },
        { "total9", SicBoLocalizer["Total"] },
        { "total10", SicBoLocalizer["Total"] },
        { "total11", SicBoLocalizer["Total"] },
        { "total12", SicBoLocalizer["Total"] },
        { "total13", SicBoLocalizer["Total"] },
        { "total14", SicBoLocalizer["Total"] },
        { "total15", SicBoLocalizer["Total"] },
        { "total16", SicBoLocalizer["Total"] },
        { "total17", SicBoLocalizer["Total"] },
        { "big", $"{Localizer["Big"]}/{Localizer["Small"]}" },
        { "small", $"{Localizer["Big"]}/{Localizer["Small"]}" },
        { "anyTriple", SicBoLocalizer["AnyTriple"] },
    };
}

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,GameTicketViewModel,SicBoTicketViewModel,RoundResultViewModel" id="tolgee_namespace" readonly hidden/>
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@Localizer["RoundId"]</th>
            <th>@Localizer["Result"]</th>
            <th>@RoundResultLocalizer["TotalPoints"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat, CultureInfo.InvariantCulture)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td>
                    @foreach (var dice in Model.RoundResult.Dices)
                    {
                        <img class="dice sicbo" src="/scss/images/sicbo_dice_@(dice).png" asp-append-version="true">
                    }
                </td>
                <td>@Model.RoundResult.Total</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["BetTime"] (@Model.TimeOffsetString)</th>
            <th>@Localizer["BetType"]</th>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {
            foreach (var bet in Model.Bets)
            {
                <tr>
                    <td>
                        @bet.Time.ToString(ViewFormat.TicketDateFormat, CultureInfo.InvariantCulture)
                        <br />
                        @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td>@betTypeDisplayDictionary[bet.Choice]</td>
                    <td class="@(Model.RoundResult.SettlementResult[bet.Choice]? "text-blue bold": string.Empty)">
                        @betChoiceDisplayDictionary[bet.Choice]
                    </td>
                    <td class="text-right @(Model.RoundResult.SettlementResult[bet.Choice]? "text-blue bold": string.Empty)">
                        @bet.Amount.Format()
                    </td>
                </tr>
            }

            <tr>
                <td></td>
                <td></td>
                <td class="text-right">@Localizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td class="text-right">@Localizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalBetWin.Format()</td>
            </tr>

            <tr class="total">
                <td></td>
                <td></td>
                <td class="bold text-right">@Localizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>