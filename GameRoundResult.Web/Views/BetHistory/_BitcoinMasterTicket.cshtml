@using GameRoundResult.Core.Constants
@model BitcoinMasterTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<BitcoinMasterTicketViewModel> Localizer

<input value="GameTicketResultViewModel,GameTicketViewModel,BitcoinMasterTicketViewModel" id="tolgee_namespace" readonly hidden />

<table class="table table-bordered table-bitcoin-master">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@Localizer["BettingPrice"]</th>
            <th>@CommonLocalizer["Result"]</th>
            <th>@CommonLocalizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td>@Model.RoundResult.Result.BettingPrice.Format2Decimals()</td>
                <td class="text-center bitcoin-master-result">
                    <span>@Model.RoundResult.Result.ResultPrice.Format2Decimals()</span>&nbsp;
                    @if (Model.RoundResult.Result.IsUp)
                    {
                        <span class="up">(<img src="~/scss/images/up.png" asp-append-version="true" /><span class="result-detail">@Model.RoundResult.Result.PriceDiff.Format2Decimals()</span>)</span>
                    }
                    else if (Model.RoundResult.Result.IsDown)
                    {
                        <span class="down">(<img src="~/scss/images/down.png" asp-append-version="true" /><span class="result-detail">@Model.RoundResult.Result.PriceDiff.Format2Decimals()</span>)</span>
                    }
                    else
                    {
                        <span class="tie">(<span class="result-detail">@Model.RoundResult.Result.PriceDiff.Format2Decimals()</span>)</span>
                    }
                </td>
                <td>
                    @string.Join(", ", Model.RoundResult.GetWinningOptionsContent().Select(s => Localizer[s]))
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                <td colspan="5" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-bitcoin-master">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["BetTime"] (@Model.TimeOffsetString)</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
            <th>@CommonLocalizer["Refund"]</th>
            <th>@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.RoundResult != null && Model.Bets.Any())
        {
            foreach (var bet in Model.Bets)
            {
                <tr>
                    <td>
                        @bet.Time.ToString(ViewFormat.TicketDateFormat)
                        <br />
                        @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td class="text-center @(bet.Win ? "text-blue bold":"")">@Localizer[$"choice_{bet.Choice}"]</td>
                    <td class="text-right @(bet.Win ? "text-blue bold":"")">@bet.Bet.Format()</td>
                    <td class="text-right @(bet.Win ? "text-blue bold":"")">@bet.Refund.Format()</td>
                    <td class="text-right @(bet.Win ? "text-blue bold":"")">@bet.GrossWin.Format()</td>
                </tr>
            }
            <tr>
                <td colspan="2" class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
                <td class="text-right">@Model.TotalRefund.Format()</td>
                <td class="text-right">@Model.TotalWin.Format()</td>
            </tr>

            <tr class="total">
                <td colspan="2" class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td colspan="3" class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>