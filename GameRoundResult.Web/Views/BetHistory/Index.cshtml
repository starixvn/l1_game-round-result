@inject IJsonStringLocalizer<GameTicketResultViewModel> Localizer
@using GameRoundResult.Core.Constants
@model GameTicketResultViewModel

@{
    ViewData["Title"] = Localizer["GameTickets"];
    ViewData["GameName"] = Enum.IsDefined(typeof(GameType), Model.GameType) ? Enum.GetName(typeof(GameType), Model.GameType).ToLowerInvariant() : string.Empty;
}

@section Styles {
    <environment include="Development">
        <link href="~/scss/pages/game-ticket.css" rel="stylesheet" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link href="~/scss/pages/game-ticket.min.css" rel="stylesheet" asp-append-version="true" />
    </environment>
}
@if(Model.EnableTolgee) {
  <input id="tolgee_language" value="@Model.Language" hidden readonly />
}
<div class="note"><span class="bold">@Localizer["Note"]:</span> @Localizer["NoteDetail"] </div>

<div id="game-ticket">
    <partial name="@Model.GetPartialViewName()" for="GameTicketResult" view-data="ViewData" />
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/tolgee/index.js"></script>
        <script src="~/js/tolgee.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.min.js"></script>
        <script src="~/lib/tolgee/index.js"></script>
        <script src="~/js/tolgee.js"></script>
    </environment>
}