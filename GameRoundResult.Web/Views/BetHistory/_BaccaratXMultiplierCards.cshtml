@using GameRoundResult.Core.Constants
@model BaccaratXRoundResultViewModel

@inject IJsonStringLocalizer<BaccaratXTicketViewModel> Localizer

<table class="table table-bordered table-baccarat">
    <tbody>
        <tr>
            <td>@Localizer["lucky_card"]</td>
            <td>
                <div class="baccarat-multiplier-cards">
                    <div class="cards">
                        @foreach (var card in Model.OddsMultipliers)
                        {
                            <div class="card card-type-@card.Type @(Model.IsMultiplierCardApplied(card) ? string.Empty : "blur" )">
                                <div class="multiplier">@Model.FormatMultiplier(card.Value)</div>
                                <span>@Card.CardLabels[card.Number]</span>
                                <img class="img" src="~/scss/images/card_@(card.Type).png" asp-append-version="true" />
                            </div>
                        }
                    </div>
                </div>
            </td>
        </tr>
    </tbody>
</table>
