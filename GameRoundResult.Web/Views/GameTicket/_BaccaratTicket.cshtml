@model BaccaratTicketViewModel
@using GameRoundResult.Core.Constants
@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer


<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@Localizer["RoundId"]</th>
            <th>@Localizer["Result"] (@Localizer["Player"] | @Localizer["Banker"])</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
        <tr>
            <td>
                @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                <br />
                @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
            </td>
            <td>@Model.RoundResult.Round</td>
            <td>
                <div class="baccarat-result">
                    <div class="cards">
                        @foreach (var card in Model.RoundResult.PlayerCards)
                        {
                            <div class="card card-type-@card.Type">
                                <span>@Card.CardLabels[card.Number]</span>
                                <img class="img" src="~/scss/images/card_@(card.Type).png" />
                            </div>
                        }
                    </div>
                    <div class="cards">
                        @foreach (var card in Model.RoundResult.BankerCards)
                        {
                            <div class="card card-type-@card.Type">
                                <span>@Card.CardLabels[card.Number]</span>
                                <img class="img" src="~/scss/images/card_@(card.Type).png" />
                            </div>
                        }
                    </div>
                </div>
            </td>
            <td>
                @if (Model.RoundResult.Player)
                {
                    @Localizer["Player"]
                }
                else
                {
                    if (Model.RoundResult.Banker)
                    {
                        @Localizer["Banker"]
                    }
                    else
                    {
                        @Localizer["Tie"];
                    }
                }

                @if (Model.RoundResult.PlayerPair)
                {
                    @($", {Localizer["PlayerPair"]}")
                }

                @if (Model.RoundResult.BankerPair)
                {
                    @($", {Localizer["BankerPair"]}")
                }

                @($", {(Model.RoundResult.Big ? Localizer["Big"] : Localizer["Small"])}")
            </td>
        </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bet != null && Model.RoundResult != null)
        {
            if (Model.Bet.Player > 0)
            {
                <tr>
                    <td>@Localizer["Player"]</td>
                    <td class="text-right">@Model.Bet.Player.Format()</td>
                </tr>
            }

            if (Model.Bet.Banker > 0)
            {
                <tr>
                    <td>@Localizer["Banker"]</td>
                    <td class="text-right">@Model.Bet.Banker.Format()</td>
                </tr>
            }

            if (Model.Bet.Tie > 0)
            {
                <tr>
                    <td>@Localizer["Tie"]</td>
                    <td class="text-right">@Model.Bet.Tie.Format()</td>
                </tr>
            }

            if (Model.Bet.PlayerPair > 0)
            {
                <tr>
                    <td>@Localizer["PlayerPair"]</td>
                    <td class="text-right">@Model.Bet.PlayerPair.Format()</td>
                </tr>
            }

            if (Model.Bet.BankerPair > 0)
            {
                <tr>
                    <td>@Localizer["BankerPair"]</td>
                    <td class="text-right">@Model.Bet.BankerPair.Format()</td>
                </tr>
            }

            if (Model.Bet.Big > 0)
            {
                <tr>
                    <td>@Localizer["Big"]</td>
                    <td class="text-right">@Model.Bet.Big.Format()</td>
                </tr>
            }
            if (Model.Bet.Small > 0)
            {
                <tr>
                    <td>@Localizer["Small"]</td>
                    <td class="text-right">@Model.Bet.Small.Format()</td>
                </tr>
            }
            <tr>
                <td class="text-right">@Localizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td class="text-right">@Localizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalWin.Format()</td>
            </tr>
            <tr class="total">
                <td class="bold text-right">@Localizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>