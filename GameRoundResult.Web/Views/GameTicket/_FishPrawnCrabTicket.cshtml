@model FishPrawnCrabTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<FishPrawnCrabTicketViewModel> Localizer

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    @foreach (var dice in Model.RoundResult.Dices)
                    {
                        <img class="animal" src="~/scss/images/animal_@(dice).png" />
                    }
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bet != null && Model.RoundResult != null)
        {
            if (Model.Bet.Stag > 0)
            {
                <tr>
                    <td>@Localizer["Stag"]</td>
                    <td class="text-right">@Model.Bet.Stag.Format()</td>
                </tr>
            }
            if (Model.Bet.Gourd > 0)
            {
                <tr>
                    <td>@Localizer["Gourd"]</td>
                    <td class="text-right">@Model.Bet.Gourd.Format()</td>
                </tr>
            }
            if (Model.Bet.Rooster > 0)
            {
                <tr>
                    <td>@Localizer["Rooster"]</td>
                    <td class="text-right">@Model.Bet.Rooster.Format()</td>
                </tr>
            }
            if (Model.Bet.Fish > 0)
            {
                <tr>
                    <td>@Localizer["Fish"]</td>
                    <td class="text-right">@Model.Bet.Fish.Format()</td>
                </tr>
            }
            if (Model.Bet.Crab > 0)
            {
                <tr>
                    <td>@Localizer["Crab"]</td>
                    <td class="text-right">@Model.Bet.Crab.Format()</td>
                </tr>
            }
            if (Model.Bet.Prawn > 0)
            {
                <tr>
                    <td>@Localizer["Prawn"]</td>
                    <td class="text-right">@Model.Bet.Prawn.Format()</td>
                </tr>
            }

            <tr>
                <td class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td class="text-right">@CommonLocalizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalWin.Format()</td>
            </tr>
            <tr class="total">
                <td class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>