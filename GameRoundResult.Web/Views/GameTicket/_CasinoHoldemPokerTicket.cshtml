@using GameRoundResult.Core.Constants
@model CasinoHoldemPokerTicketViewModel
@inject IStringLocalizer<GameTicketViewModel> Localizer
@inject IStringLocalizer<CasinoHoldemPokerTicketViewModel> CasinoHolemLocalizer
<div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="col-date">@Localizer["Time"] (GMT-4)</th>
                <th class="col-round-id">@Localizer["RoundId"]</th>
                <th></th>
                <th>@Localizer["Cards"]</th>
                <th>@Localizer["Combination"]</th>
                <th>@Localizer["Result"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bet != null)
            {
                <tr>
                    <td rowspan="3">@Model.Round.Time</td>
                    <td rowspan="3">@Model.Round.Round</td>
                    <td>@CasinoHolemLocalizer["Player"]</td>
                    <td class="blackjack-result">
                        <div class="cards">
                            @foreach (var card in Model.Player.Cards)
                            {
                                <div class="card card-type-@card.Suit">
                                    <span>@Card.CardLabels[card.Rank]</span>
                                    <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                </div>
                            }
                        </div>
                    </td>
                    <td class="blackjack-result">
                        <div class="cards">
                            @foreach (var card in Model.Player.CombinationCards)
                            {
                                <div class="card card-type-@card.Suit">
                                    <span>@Card.CardLabels[card.Rank]</span>
                                    <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                </div>
                            }
                        </div>
                    </td>
                    <td>@CasinoHolemLocalizer[Model.Player.Rank]</td>
                </tr>
                <tr>
                    <td>@CasinoHolemLocalizer["Dealer"]</td>
                    <td class="blackjack-result">
                        <div class="cards">
                            @if (Model.Ended && !Model.IsFold)
                            {
                                @foreach (var card in Model.Dealer.Cards)
                                {
                                    <div class="card card-type-@card.Suit">
                                        <span>@Card.CardLabels[card.Rank]</span>
                                        <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                    </div>
                                }
                            }
                            else
                            {
                                <img class="card" src="~/scss/images/card_back.png" />
                                <img class="card" src="~/scss/images/card_back.png" />
                            }
                        </div>
                    </td>
                    <td class="blackjack-result">
                        <div class="cards">
                            @if (Model.Ended && !Model.IsFold)
                            {
                                @foreach (var card in Model.Dealer.CombinationCards)
                                {
                                    <div class="card card-type-@card.Suit">
                                        <span>@Card.CardLabels[card.Rank]</span>
                                        <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div>-</div>
                            }
                        </div>
                    </td>
                    @if (Model.Ended && !Model.IsFold)
                    {
                        @if (Model.IsQualified)
                        {
                            <td>@CasinoHolemLocalizer[Model.Dealer.Rank]</td>
                        }
                        else
                        {
                            <td>@CasinoHolemLocalizer["DoesNotQualify"]</td>
                        }
                    }
                    else
                    {

                        <td>-</td>
                    }
                </tr>
                <tr>
                    <td>@CasinoHolemLocalizer["CommunityCards"]</td>
                    <td class="blackjack-result">
                        <div class="cards">
                            @foreach (var card in Model.CommunityCards)
                            {
                                <div class="card card-type-@card.Suit">
                                    <span>@Card.CardLabels[card.Rank]</span>
                                    <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                </div>
                            }
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        @Localizer["NoDataAvailable"]
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="col-date">@Localizer["Time"] (GMT-4)</th>
                <th>@Localizer["BetChoice"]</th>
                <th>@Localizer["Odds"]</th>
                <th>@CasinoHolemLocalizer["Stake"]</th>
                <th>@Localizer["Win"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Bet != null)
            {
                var winAnte = (Model.Bet.SettlementResult?.Ante ?? 0);
                var winAA = (Model.Bet.SettlementResult?.Aa ?? 0);
                var winCall = (Model.Bet.SettlementResult?.Call ?? 0);
                <tr class="@(winAnte > 0 ? "text-blue bold" : "")">
                    <td>@Model.Bet.Time</td>
                    <td>@Localizer["Ante"]</td>
                    <td>@Model.Bet.AnteOdds</td>
                    <td>@Model.Bet.Ante.Format()</td>
                    @if (Model.Ended)
                    {
                        <td>
                            @(winAnte.Format())
                        </td>
                    }
                    else
                    {
                        <td>@Localizer["UnfinishedGame"]</td>
                    }
                </tr>
                <tr class="@(winAA > 0 ? "text-blue bold" : "")">
                    <td>@Model.Bet.Time</td>
                    <td>@Localizer["AA"]</td>
                    <td>@Model.Bet.AaOdds</td>
                    <td>@Model.Bet.Aa.Format()</td>
                    @if (Model.Ended)
                    {
                        <td>
                            @(winAA.Format())
                        </td>
                    }
                    else
                    {
                        <td>@Localizer["UnfinishedGame"]</td>
                    }
                </tr>
                @if (Model.Ended)
                {
                    <tr class="@(winCall > 0 ? "text-blue bold" : "")">
                        <td>@Model.Bet.CallTime</td>
                        <td>@Localizer["Call"]</td>
                        <td>@Model.Bet.CallOdss</td>
                        <td>@Model.Bet.Call.Format()</td>
                        <td>
                            @(winCall.Format())
                        </td>
                    </tr>
                }
                <tr>
                    <td></td>
                    <td></td>
                    <td>@Localizer["Total"]</td>
                    <td>@Model.TotalBet.Format()</td>
                    @if (Model.Ended)
                    {
                        <td>@Model.TotalWin.Format()</td>
                    }
                    else
                    {
                        <td>@Localizer["UnfinishedGame"]</td>
                    }
                </tr>
                <tr class="total">
                    <td></td>
                    <td></td>
                    <td>@Localizer["WinLoss"]</td>
                    <td colspan="2">@(Model.TotalWin - Model.TotalBet)</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        @Localizer["NoDataAvailable"]
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>