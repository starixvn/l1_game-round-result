@model KenoPowerTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<KenoPowerTicketViewModel> Localizer

@{
    var betChoiceMapper = new Dictionary<string, string>
{
        { "player", CommonLocalizer["Player"] },
        { "banker", CommonLocalizer["Banker"] },
        { "big", CommonLocalizer["Big"] },
        { "small", CommonLocalizer["Small"] },
        { "odd", CommonLocalizer["Odd"] },
        { "even", CommonLocalizer["Even"] },
        { "red", Localizer["Red"] },
        { "orange", Localizer["Orange"] },
        { "yellow", Localizer["Yellow"] },
        { "green", Localizer["Green"] },
        { "blue", Localizer["Blue"] },
        { "indigo", Localizer["Indigo"] },
        { "violet", Localizer["Violet"] },
    };

    var betTypeMapper = new Dictionary<string, string>
{
        { "player", Localizer["Player/Banker"] },
        { "banker", Localizer["Banker/Banker"] },
        { "big", Localizer["Sum Big/Small"] },
        { "small", Localizer["Sum Big/Small"] },
        { "odd", Localizer["Sum Even/Odd"] },
        { "even", Localizer["Sum Even/Odd"] },
        { "red", Localizer["Sum Color"] },
        { "orange", Localizer["Sum Color"] },
        { "yellow", Localizer["Sum Color"] },
        { "green", Localizer["Sum Color"] },
        { "blue", Localizer["Sum Color"] },
        { "indigo", Localizer["Sum Color"] },
        { "violet", Localizer["Sum Color"] },
    };

    var result = Model.RoundResult.Result;
    var playerSum = result.Player.Sum(x => x);
    var bankerSum = result.Banker.Sum(x => x);
    var settlementResult = Model.RoundResult.SettlementResult;

    var settlementResultMapper = new Dictionary<string, bool>
{
        { "player", settlementResult.Player },
        { "banker", settlementResult.Banker },
        { "big", settlementResult.Big },
        { "small", settlementResult.Small },
        { "odd", settlementResult.Odd },
        { "even", settlementResult.Even },
        { "red", settlementResult.Red },
        { "orange", settlementResult.Orange },
        { "yellow", settlementResult.Yellow },
        { "green", settlementResult.Green },
        { "blue", settlementResult.Blue },
        { "indigo", settlementResult.Indigo },
        { "violet", settlementResult.Violet },
    };
}

<table class="table table-bordered table-keno-power">
    <thead>
        <tr>
            <th rowspan="2" class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th rowspan="2" class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th rowspan="2">@CommonLocalizer["Result"]</th>
            <th colspan="2">@CommonLocalizer["WinningOptions"]</th>
        </tr>
        <tr>
            <th>@Localizer["Player"]/@Localizer["Banker"]</th>
            <th>@Localizer["Player"]</th>
            <th>@Localizer["Banker"]</th>
            <th>@Localizer["Total"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr class="bold">
                                <td>@Localizer["Player"]</td>
                                <td>@Localizer["Banker"]</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="number-list">
                                        @foreach (var number in result.Player)
                                        {
                                            <span class="number blue">@number</span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <div class="number-list">
                                        @foreach (var number in result.Banker)
                                        {
                                            <span class="number red">@number</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>@Localizer["Player"] @playerSum - @Localizer["Total"] @(playerSum + bankerSum) - @Localizer["Banker"] @bankerSum</td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td>
                    @if (settlementResult.Player)
                    {
                        @Localizer["Player"]
                    }
                    @if (settlementResult.Banker)
                    {
                        @Localizer["Banker"]
                    }
                </td>
                <td>
                    @if (settlementResult.PlayerBig)
                    {
                        @CommonLocalizer["Big"]
                    }
                    @if (settlementResult.PlayerSmall)
                    {
                        @CommonLocalizer["Small"]
                    }
                </td>
                <td>
                    @if (settlementResult.BankerBig)
                    {
                        @CommonLocalizer["Big"]
                    }
                    @if (settlementResult.BankerSmall)
                    {
                        @CommonLocalizer["Small"]
                    }
                </td>
                <td>
                    <div>
                        @if (settlementResult.Big)
                        {
                            @CommonLocalizer["Big"]
                        }
                        else
                        {
                            @CommonLocalizer["Small"]
                        }
                    </div>
                    <div>
                        @if (settlementResult.Even)
                        {
                            @CommonLocalizer["Even"]
                        }
                        else
                        {
                            @CommonLocalizer["Odd"]
                        }
                    </div>

                    @if (settlementResult.Red)
                    {
                        @Localizer["Red"]
                    }
                    @if (settlementResult.Orange)
                    {
                        @Localizer["Orange"]
                    }
                    @if (settlementResult.Yellow)
                    {
                        @Localizer["Yellow"]
                    }
                    @if (settlementResult.Green)
                    {
                        @Localizer["Green"]
                    }
                    @if (settlementResult.Blue)
                    {
                        @Localizer["Blue"]
                    }
                    @if (settlementResult.Indigo)
                    {
                        @Localizer["Indigo"]
                    }
                    @if (settlementResult.Violet)
                    {
                        @Localizer["Violet"]
                    }
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["BetTime"] (GMT-4)</th>
            <th>@CommonLocalizer["BetType"]</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["Odds"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
            <th>@CommonLocalizer["Refund"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {
            foreach (var bet in Model.Bets)
            {
                var cssClass = settlementResultMapper[bet.Choice] ? "text-blue bold" : string.Empty;
                var choiceOdds = Model.Odds[bet.Choice];
                <tr>
                    <td>
                        @bet.Time.ToString(ViewFormat.TicketDateFormat)
                        <br />
                        @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td class="@cssClass">
                        @betTypeMapper[bet.Choice]
                    </td>
                    <td class="@cssClass">
                        @betChoiceMapper[bet.Choice]
                    </td>
                    <td class="@cssClass">
                        @choiceOdds.Format()
                    </td>
                    <td class="text-right @cssClass">
                        @bet.Amount.Format()
                    </td>
                    <td class="text-right @cssClass">
                        @bet.GetRefund(settlementResult).Format()
                    </td>
                </tr>
            }

            <tr>
                <td colspan="4" class="text-right">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td colspan="4" class="text-right">@Localizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalBetWin.Format()</td>
            </tr>
            <tr class="total">
                <td colspan="4" class="bold text-right">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>