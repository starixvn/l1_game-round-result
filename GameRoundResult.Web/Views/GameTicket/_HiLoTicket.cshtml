@using Microsoft.Extensions.Localization
@model HiLoTicketViewModel

@inject IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IStringLocalizer<HiLoTicketViewModel> HiLoLocalizer

<table class="table table-bordered table-blackjack">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@HiLoLocalizer["Turn"]</th>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@HiLoLocalizer["Base Card"]</th>
            <th>@HiLoLocalizer["Result Card"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
            <th>@CommonLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.TicketDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                </td>
                <td rowspan="@(Model.BetLogs.Count() + 2)">
                    @Model.RoundResult.Round
                </td>
                <td colspan="4">@HiLoLocalizer["Start Round"]</td>
                <td class="bold text-right">@Model.RoundResult.Amount.Format()</td>
                <td></td>
            </tr>
            @foreach (var betLog in Model.BetLogs)
            {
                <tr>
                    <td>
                        @betLog.Time.ToString(ViewFormat.TicketDateFormat)
                        <br />
                        @betLog.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                    </td>
                    <td>@betLog.Order</td>
                    <td>@HiLoLocalizer[betLog.Choice]</td>
                    @foreach (var card in betLog.Cards)
                    {
                        <td class="blackjack-result">
                            <div class="cards">

                                <div class="card card-type-@card.Suit">
                                    <span>@card.Rank</span>
                                    <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                                </div>
                            </div>
                        </td>
                    }
                    <td class="text-right bold">@betLog.Amount.Format()</td>
                    <td class="text-right bold">@betLog.Betwin.Format()</td>
                </tr>
            }
            <tr>
                <td>
                    @Model.RoundResult.EndTime?.ToString(ViewFormat.TicketDateFormat)
                    <br />
                    @Model.RoundResult.EndTime?.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                </td>

                <td colspan="4">@HiLoLocalizer["End Round"]</td>
                <td></td>
                <td class="bold text-right">@Model.RoundResult.Betwin.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>