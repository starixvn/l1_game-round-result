@model BaseCascadingSlotTicketViewModel
@using GameRoundResult.Core.Constants;

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<BaseCascadingSlotTicketViewModel> Localizer

@{
    var roundResult = Model.Round;
}
<table class="table table-bordered table-cascading-slot">
    <thead>
        <tr>
            <th>@Localizer["No"]</th>
            <th>@Localizer["ResultBoard"]</th>
            <th colspan="2">@Localizer["WinSymbols"]</th>
            <th>@Localizer["WinAmount"]</th>
            <th>@Localizer["TumbleWin"]</th>
        </tr>
    </thead>
    <tbody>
        @if (roundResult != null)
        {
            var tumbles = roundResult.SettlementResult.Tumbles.ToList();
            decimal tumbleWin = 0;

            for (byte index = 0; index < tumbles.Count; index++)
            {
                var rowspan = tumbles[index].Icons.Keys.Count > 0 ? tumbles[index].Icons.Keys.Count : 1;
                if (tumbles[index].Icons.Any())
                {
                    tumbleWin += tumbles[index].Win;

                    foreach (var item in tumbles[index].Icons.Keys.Select((key, i) => new { index = i, key }))
                    {
                        if (item.index == 0)
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index + 1)</td>
                                <td rowspan="@rowspan">
                                    <component type="typeof(CascadingBoard)"
                                    render-mode="Static" 
                                    param-Multipliers="tumbles[index].Multipliers"
                                    param-Board="tumbles[index].Board"
                                    param-StaticResourceUrl="Model.StaticResourceUrl"
                                    param-GameName="Model.GameName" 
                                    param-GameId="Model.GameId" />
                                </td>
                                <td>
                                    <component type="typeof(Symbol)"
                                    render-mode="Static"
                                    param-Number="item.key"
                                    param-StaticResourceUrl="Model.StaticResourceUrl"
                                    param-GameName="Model.GameName" />
                                </td>
                                <td>@tumbles[index].Icons[item.key].Count</td>
                                <td>@tumbles[index].Icons[item.key].Win.Format(roundResult.XMode)</td>
                                <td rowspan="@rowspan">@tumbleWin.Format(roundResult.XMode)</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>
                                    <component type="typeof(Symbol)"
                                    render-mode="Static"
                                    param-Number="item.key"
                                    param-StaticResourceUrl="Model.StaticResourceUrl"
                                    param-GameName="Model.GameName" />
                                </td>
                                <td>@tumbles[index].Icons[item.key].Count</td>
                                <td>@tumbles[index].Icons[item.key].Win.Format(roundResult.XMode)</td>
                            </tr>
                        }

                    }
                }
                else
                {
                    var additionalFreeSpins = roundResult.SettlementResult.FreeSpins;
                    <tr>
                        <td rowspan="@rowspan">@(index + 1)</td>
                        <td rowspan="@rowspan">
                            <component type="typeof(CascadingBoard)"
                            render-mode="Static"
                            param-Multipliers="tumbles[index].Multipliers"
                            param-Board="tumbles[index].Board"
                            param-StaticResourceUrl="Model.StaticResourceUrl"
                            param-GameName="Model.GameName"
                            param-GameId="Model.GameId" />
                        </td>
                        @if (additionalFreeSpins.Odds > 0 || additionalFreeSpins.Win > 0)
                        {
                            <td>
                                <component type="typeof(Symbol)"
                                render-mode="Static"
                                param-Number="CascadingSlotGameConstant.FreeSpinSymbol"
                                param-StaticResourceUrl="Model.StaticResourceUrl"
                                param-GameName="Model.GameName" />
                            </td>
                            <td>@additionalFreeSpins.Count</td>
                            <td>
                                @if (additionalFreeSpins.Win > 0)
                                {
                                    @additionalFreeSpins.Win?.Format()
                                }

                                @if(additionalFreeSpins.Win > 0 && additionalFreeSpins.Odds > 0)
                                {
                                    <br />
                                }

                                @if(additionalFreeSpins.Odds > 0)
                                {
                                    @additionalFreeSpins.Odds @(roundResult.FreeSpin ? $" {Localizer["ExtraFreeSpin"]}" : $" {Localizer["FreeSpins"]}")
                                }
                            </td>

                        }
                        else
                        {
                            <td colspan="2">-</td>
                            <td>0</td>
                        }
                        <td rowspan="@rowspan">@roundResult.SettlementResult.DisplayTumbleWin</td>
                    </tr>
                }
            }
            @if (roundResult.BetWin > 0 && roundResult.Multiplier > 0 && tumbles.Count > 1)
            {
                <tr>
                    <td colspan="5" class="text-right">@Localizer["TotalMultiplier"]</td>
                    <td>@(roundResult.FreeSpin ? roundResult.TotalMultiplier : roundResult.Multiplier)</td>
                </tr>
            }
            <tr>
                <td colspan="5" class="text-right">@(roundResult.ReachMaxWin ? $"({Localizer["ReachMaxWin"]}) {CommonLocalizer["Win"]}" : CommonLocalizer["Win"])</td>
                <td>@roundResult.DisplayBetWin</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>
