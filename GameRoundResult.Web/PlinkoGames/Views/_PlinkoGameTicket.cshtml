
@model PlinkoGameTicketViewModel

@inject IJsonStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject IJsonStringLocalizer<PlinkoGameTicketViewModel> Localizer

@{
    var isLightningMode = Model.RoundResult != null && Model.RoundResult.LightningBoard != null;
}

@if (Model.EnableTolgee)
{
    <input value="GameTicketResultViewModel,Common,Spaceflight" id="tolgee_namespace" readonly hidden />
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th id="time" class="col-date" style="width: 245px">@CommonLocalizer["Time"] (@Model.TimeOffsetString)</th>
            <th id="roundId" class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th id="betAmount">@CommonLocalizer["BetAmount"]</th>
            <th id="result">@CommonLocalizer["Result"]</th>
            <th id="win">@CommonLocalizer["Win"]</th>
            <th id="winLoss">@CommonLocalizer["WinLoss"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.DisplayRoundDate
                    <br />
                    @Model.RoundResult.DisplayRoundTime
                </td>
                <td>@Model.RoundResult.RoundId</td>
                <td class="text-center">@Model.DisplayAmount(@Model.RoundResult.Amount)</td>
                <td>
                    @Model.RoundResult.DisplayResult
                </td>
                <td class="text-center">@Model.DisplayBetWin</td>
                <td class="bold text-center @(Model.WinLossRowClassName)">@Model.DisplayWinLoss</td>
            </tr>

            @if (Model.RoundResult.ReachMaxWin)
            {
                <tr>
                    <th id="max-win" class="text-right">
                        @($"{CommonLocalizer["you_reached_max_win"]}")
                    </th>
                    <td class="text-right">
                        @Model.DisplayBetWin
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

@if (isLightningMode)
{
    <table class="table table-bordered text-center">
        <tbody>
            <tr>
                <th style="width: 245px">@CommonLocalizer["payout_slot"]</th>
                <td>@Model.RoundResult.DisplayPayoutSlot</td>
            </tr>
            <tr>
                <th>@CommonLocalizer["total_multiplier"]</th>
                <td>@Model.RoundResult.TotalMultiplier</td>
            </tr>
        </tbody>
    </table>
}

@if (isLightningMode)
{
    <div class="bold">@CommonLocalizer["multiplier_position"]</div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th style="width: 245px">@CommonLocalizer["column"]</th>
                <th>@CommonLocalizer["row"]</th>
                <th>@CommonLocalizer["multiplier"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RoundResult != null)
            {
                <tr>
                    @foreach (var item in Model.RoundResult.LightningBoard.PegMultipliers)
                    {
                        var className = Model.RoundResult.SettlementResult.ReachedPegMultipliers.Any(x => x.Column == item.Column && x.Row == item.Row) ? "bet-win-text" : "";
                        
                        <tr >
                            <td class="@className">@(@item.Column + 2)</td>
                            <td class="@className">@(@item.Row + 1)</td>
                            <td class="@className">@item.Multiplier</td>
                        </tr>
                    }
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">
                        @CommonLocalizer["NoDataAvailable"]
                    </td>
                </tr>
            }
        </tbody>
    </table>
}