@using GameRoundResult.Web.Models.RoundHistory

@inject IJsonStringLocalizer<GameTicketViewModel> GameTicketLocalizer
@inject IJsonStringLocalizer<RoundResultViewModel> RoundResultLocalizer

@model RoundHistoryBetLogViewModel

<input id="tolgee_language" value="en-US" hidden readonly />
<input value="GameRoundResultViewModel,RoundResultViewModel,GameType" id="tolgee_namespace" readonly hidden />

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@GameTicketLocalizer["BetTime"] (@Model.TicketModel.TimeOffsetString)</th>
            <th>@GameTicketLocalizer["BetChoice"]</th>
            <th>@GameTicketLocalizer["Odds"]</th>
            <th>@GameTicketLocalizer["Stake"]</th>
            <th>@GameTicketLocalizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var row in Model.TicketModel.BuildBetLogs(RoundResultLocalizer, Model.ConvertToUSD, Model.BaseCurrencyMultiplier))
        {
            @Html.Raw(row)
        }
    </tbody>
</table>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/data-tables/datatables.js"></script>
        <script src="~/lib/flatpickr/dist/flatpickr.js"></script>
        <script src="~/js/game-round-result.js" asp-append-version="true"></script>
       
            <script src="~/lib/tolgee/index.js"></script>
            <script src="~/js/tolgee.js" asp-append-version="true"></script>
      
    </environment>
    <environment exclude="Development">
        <script src="~/js/game-round-result.min.js" asp-append-version="true"></script>
        <script src="~/lib/tolgee/index.js"></script>
        <script src="~/js/tolgee.js" asp-append-version="true"></script>
       
    </environment>
}