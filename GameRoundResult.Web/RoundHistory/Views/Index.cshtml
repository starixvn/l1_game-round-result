@using GameRoundResult.Web.Models.RoundHistory
@model RoundHistoryViewModel
@inject IJsonStringLocalizer<RoundResultViewModel> Localizer
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine ViewEngine

@section Styles {
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/scss/pages/modal.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/scss/pages/site.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/scss/pages/game-ticket.min.css" rel="stylesheet" asp-append-version="true" />
}

<input id="tolgee_language" value="en-US" hidden readonly />
<input value="GameRoundResultViewModel,RoundResultViewModel,GameType,CoinToss,BacBall,FootballCoinToss,BaccaratX" id="tolgee_namespace" readonly hidden />

<table class="table table-bordered sticky-table" style="width:100%">
    <thead>
        <tr>
            <th>Round Id</th>
            <th>Exchange Id</th>
            <th class="col-result" style="min-width: 350px;">Result</th>
            <th>Winning Options</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Round != null)
        {
            <tr>
                <td style="padding: 15px 5px;">
                    @Html.Raw(@Model.Request.RoundId)
                </td>
                <td>
                    @Html.Raw(@Model.Round.ExchangeRateId)
                </td>
                <td>
                    @Html.Raw(@Model.Round.GetResult(Localizer))
                </td>
                <td _tolgee="true">
                    @Html.Raw(@Model.Round.GetWinningTextResult(Localizer))
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td class="text-center" colspan="4" style="padding: 5px;">No data</td>
            </tr>
        }
    </tbody>
</table>

@if (!string.IsNullOrWhiteSpace(Model.AdditionalViewName) && Model.Round != null)
{
    <partial name="@Model.AdditionalViewName" for="Round" />
}

<table class="table table-bordered sticky-table table-dragon-tiger bandar-qiuqiu-table" style="width:100%; margin-top: 10px;">
    <thead>
        <tr>
            <th>Date <br /> (GMT+7)</th>
            <th>Operator</th>
            <th>Username</th>
            <th>Nickname</th>
            <th>Currency</th>
            <th>Total Bet</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.Round != null)
        {
            @foreach (var bet in Model.Bets)
            {
                <tr>
                    <td style="padding: 15px 5px;">
                        @bet.DateDisplay <br />
                        @bet.TimeDisplay
                    </td>
                    <td>
                        @bet.OperatorName
                    </td>
                    <td>
                        @bet.Username
                    </td>
                    <td>
                        @bet.Name
                    </td>
                    <td>
                        @bet.Currency
                    </td>
                    <td>
                        <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                   asp-action="GetBetHistory"
                   asp-route-game="@Model.Request.Game"
                   asp-route-roundId="@Model.Request.RoundId"
                   asp-route-userId="@bet.PlayerId"
                   asp-route-partnerId="@bet.OperatorId"
                   asp-route-convertToUSD="@Model.Request.ConvertToUSD">
                            @Model.DisplayAmount(bet.TotalAmount, bet.Rate)
                        </a>
                    </td>
                    <td>
                        @Model.DisplayAmount(bet.Betwin, bet.Rate)
                    </td>
                </tr>
            }
            if (Model.Request.ConvertToUSD)
            {
                <tr class="total">
                    <td colspan="5" style="padding: 10px 20px; text-align: right;">Total in @Model.BaseCurrency</td>
                    <td class="text-center">@Model.DisplayTotalBet</td>
                    <td class="text-center">@Model.DisplayTotalBetwin</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td class="text-center" colspan="7" style="padding: 5px;">No data</td>
            </tr>
        }
    </tbody>
</table>

<partial name="~/RoundHistory/Views/_Modal.cshtml" />

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script src="~/lib/data-tables/datatables.js"></script>
        <script src="~/lib/flatpickr/dist/flatpickr.js"></script>
        <script src="~/js/game-round-result.js" asp-append-version="true"></script>
        <script src="~/lib/tolgee/index.js"></script>
        <script src="~/js/tolgee.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/game-round-result.min.js" asp-append-version="true"></script>
        <script src="~/lib/tolgee/index.js"></script>
        <script src="~/js/tolgee.js" asp-append-version="true"></script>
    </environment>

    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
}