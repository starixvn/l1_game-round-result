@model LotteryTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<LotteryTicketViewModel> LotteryLocalizer

@{
    var settlementResult = Model.SettlementResult;
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@Localizer["RoundId"]</th>
            <th>@Localizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    <table class="table table-bordered table-hover bold">
                        <tbody>
                            <tr>
                                <td>@LotteryLocalizer["SpecialPrize"]</td>
                                <td colSpan="12" class="text-center text-red">
                                    @Model.RoundResult.Special.FirstOrDefault()
                                </td>
                            </tr>
                            <tr>
                                <td>@LotteryLocalizer["First"]</td>
                                <td colSpan="12">
                                    @Model.RoundResult.First.FirstOrDefault()
                                </td>
                            </tr>
                            <tr>
                                <td>@LotteryLocalizer["Second"]</td>
                                @foreach (var number in Model.RoundResult.Second)
                                {
                                    <td colSpan="6">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td rowSpan="2">@LotteryLocalizer["Third"]</td>
                                @foreach (var number in Model.RoundResult.Third.ToList().GetRange(0, 3))
                                {
                                    <td colSpan="4">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                @foreach (var number in Model.RoundResult.Third.ToList().GetRange(3, 3))
                                {
                                    <td colSpan="4">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td>@LotteryLocalizer["Fourth"]</td>
                                @foreach (var number in Model.RoundResult.Fourth)
                                {
                                    <td colSpan="3">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td rowSpan="2">@LotteryLocalizer["Fifth"]</td>
                                @foreach (var number in Model.RoundResult.Fifth.ToList().GetRange(0, 3))
                                {
                                    <td colSpan="4">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                @foreach (var number in Model.RoundResult.Fifth.ToList().GetRange(3, 3))
                                {
                                    <td colSpan="4">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td>@LotteryLocalizer["Sixth"]</td>
                                @foreach (var number in Model.RoundResult.Sixth)
                                {
                                    <td colSpan="4">
                                        @number
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td>@LotteryLocalizer["Seventh"]</td>
                                @foreach (var number in Model.RoundResult.Seventh)
                                {
                                    <td colSpan="3" class="text-center text-red">
                                        @number
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["BetTime"] (GMT-4)</th>
            <th>@Localizer["BetType"]</th>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["Odds"]</th>
            <th>@Localizer["BetAmount"]</th>
            <th>@Localizer["Win"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {

            foreach (var bet in Model.Bets)
            {
                var renderGroupInfo = true;

                foreach (var betChoice in bet.Choices.FourSets)
                {
                    var rowSpan = bet.Choices.FourSets.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["4 Sets"]
                            </td>
                        }
                        <td>
                            @betChoice.Key
                        </td>
                        <td>
                            @Model.Odds.FourSets
                            @{
                                byte occurence = settlementResult.Occurrences.Seventh.ContainsKey(betChoice.Key) ? settlementResult.Occurrences.Seventh[betChoice.Key] : (byte)0;
                                if (occurence > 1)
                                {
                                    @("(")<span class="text-red">@($"x{occurence}")</span>@(")")
                                }
                            }
                        </td>

                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @((betChoice.Value * Model.Odds.FourSets * occurence).Format())
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Special)
                {
                    var rowSpan = bet.Choices.Special.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Special"]
                            </td>
                        }
                        <td>
                            @betChoice.Key
                        </td>
                        <td>
                            @Model.Odds.Special
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (settlementResult.Special == betChoice.Key)
                            {
                                @((betChoice.Value * Model.Odds.Special).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Head)
                {
                    var rowSpan = bet.Choices.Head.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>

                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Head"]
                            </td>
                        }
                        <td>
                            @betChoice.Key
                        </td>
                        <td>
                            @Model.Odds.Head
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (settlementResult.Head == betChoice.Key)
                            {
                                @((betChoice.Value * Model.Odds.Head).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Tail)
                {
                    var rowSpan = bet.Choices.Tail.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>

                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Tail"]
                            </td>
                        }

                        <td>
                            @betChoice.Key
                        </td>
                        <td>
                            @Model.Odds.Tail
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (settlementResult.Tail == betChoice.Key)
                            {
                                @((betChoice.Value * Model.Odds.Tail).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.TwentySevenSets)
                {
                    var rowSpan = bet.Choices.TwentySevenSets.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["27 Sets"]
                            </td>
                        }
                        <td>
                            @betChoice.Key
                        </td>
                        <td>
                            @Model.Odds.TwentySevenSets
                            @{
                                byte occurence = settlementResult.Occurrences.All.ContainsKey(betChoice.Key) ? settlementResult.Occurrences.All[betChoice.Key] : (byte)0;
                                if (occurence > 1)
                                {
                                    @("(")<span class="text-red">@($"x{occurence}")</span>@(")")
                                }
                            }
                        </td>

                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @((betChoice.Value * Model.Odds.TwentySevenSets * occurence).Format())
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Parlay2)
                {
                    var rowSpan = bet.Choices.Parlay2.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Parlay 2"]
                            </td>
                        }

                        <td>
                            @betChoice.Key.Replace("-", ", ")
                        </td>
                        <td>
                            @Model.Odds.Parlay2
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                            {
                                @((betChoice.Value * Model.Odds.Parlay2).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Parlay3)
                {
                    var rowSpan = bet.Choices.Parlay3.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Parlay 3"]
                            </td>
                        }

                        <td>
                            @betChoice.Key.Replace("-", ", ")
                        </td>
                        <td>
                            @Model.Odds.Parlay3
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                            {
                                @((betChoice.Value * Model.Odds.Parlay3).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Parlay4)
                {
                    var rowSpan = bet.Choices.Parlay4.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Parlay 3"]
                            </td>
                        }

                        <td>
                            @betChoice.Key.Replace("-", ", ")
                        </td>
                        <td>
                            @Model.Odds.Parlay4
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (betChoice.Key.Split("-").All(number => settlementResult.TwentySevenSets.Contains(number)))
                            {
                                @((betChoice.Value * Model.Odds.Parlay4).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }

                foreach (var betChoice in bet.Choices.Others)
                {
                    var rowSpan = bet.Choices.Others.Count();
                    <tr>
                        @if (renderGroupInfo)
                        {
                            renderGroupInfo = false;
                            <td rowspan="@rowSpan">
                                @bet.Time.ToString(ViewFormat.TicketDateFormat)
                                <br />
                                @bet.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
                            </td>
                            <td rowspan="@rowSpan">
                                @LotteryLocalizer["Others"]
                            </td>
                        }
                        <td class="text-center text-capitalize">
                            @LotteryLocalizer[@betChoice.Key]
                        </td>
                        <td>
                            @Model.Odds.Others
                        </td>
                        <td class="text-right">
                            @betChoice.Value.Format()
                        </td>
                        <td class="text-right">
                            @if (settlementResult.Others[betChoice.Key])
                            {
                                @((betChoice.Value * Model.Odds.Others).Format())
                            }
                            else
                            {
                                @(0)
                            }
                        </td>
                    </tr>
                }
            }

            <tr class="total">
                <td colspan="4" class="text-right">@Localizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
                <td class="text-right">@Model.TotalBetWin.Format()</td>
            </tr>

            <tr class="total">

                <td colspan="4" class="bold text-right">@Localizer["WinLoss"]</td>
                <td></td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="6">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>