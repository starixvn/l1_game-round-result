@model RouletteTicketViewModel
@using GameRoundResult.Core.Constants
@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer

@{ 
    var resultColorCssClass = string.Empty;

    if(Model.RoundResult.Result == 0 )
    {
        resultColorCssClass = "text-green";
    }
    else
    {
        if (Roulette.RedNumbers.Any(x => x == Model.RoundResult.Result))
        {
            resultColorCssClass = "text-red";
        }
    }
}

<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@Localizer["RoundId"]</th>
            <th>@Localizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.Round</td>
                <td class="bold @resultColorCssClass">
                    @Model.RoundResult.Result
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-baccarat">
    <thead>
        <tr>
            <th class="col-date">@Localizer["BetTime"] (GMT-4)</th>
            <th>@Localizer["BetType"]</th>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {
            foreach (var bet in Model.Bets)
            {
                @await Html.PartialAsync("_RouletteBetRow", new RouletteBetRowViewModel { Bet = bet, SettlementResult = Model.RoundResult.SettlementResult })
            }
            <tr>
                <td colspan="3" class="text-right">@Localizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td colspan="3" class="text-right">@Localizer["TotalWin"]</td>
                <td class="text-right">@Model.BetWin.Format()</td>
            </tr>
            <tr class="total">
                <td colspan="3" class="bold text-right">@Localizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>