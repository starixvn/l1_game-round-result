@model ThreeCardsTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> CommonLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<ThreeCardsTicketViewModel> Localizer

@{
    var settlementResult = Model.RoundResult.SettlementResult;
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@CommonLocalizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@CommonLocalizer["RoundId"]</th>
            <th>@CommonLocalizer["Result"]</th>
            <th>@CommonLocalizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundDateFormat)
                    <br />
                    @Model.RoundResult.Time.ToString(ViewFormat.RoundTimeWithSecondFormat, CultureInfo.InvariantCulture)
                </td>
                <td>@Model.RoundResult.Round</td>
                <td class="three-cards-result">
                    <div class="cards">
                        @foreach (var card in Model.RoundResult.Result)
                        {
                            <div class="card card-type-@card.Suit">
                                <span>@card.Rank</span>
                                <img class="img" src="~/scss/images/card_@(card.Suit).png" />
                            </div>
                        }
                    </div>
                </td>
                <td class="bold">
                    @if (settlementResult.Red)
                    {
                        <span class="text-red">@Localizer["Red"]</span>
                    }
                    else
                    {
                        <span>@Localizer["Black"]</span>
                    }

                    @if (settlementResult.Diamonds)
                    {
                        <span>, <span class="text-red">@Localizer["Diamonds"]</span></span>
                    }

                    @if (settlementResult.Hearts)
                    {
                        <span>, <span class="text-red">@Localizer["Hearts"]</span></span>
                    }

                    @if (settlementResult.Spades)
                    {
                        <span>, @Localizer["Spades"]</span>
                    }

                    @if (settlementResult.Clubs)
                    {
                        <span>, @Localizer["Clubs"]</span>
                    }

                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@CommonLocalizer["BetChoice"]</th>
            <th>@CommonLocalizer["Odds"]</th>
            <th>@CommonLocalizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bet != null && Model.RoundResult != null)
        {
            if (Model.Bet.Red > 0)
            {
                <tr class="@(settlementResult.Red ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Red"]</td>
                    <td class="text-right">@Model.Bet.Odds.Red</td>
                    <td class="text-right">@Model.Bet.Red.Format()</td>
                </tr>
            }
            if (Model.Bet.Black > 0)
            {
                <tr class="@(settlementResult.Black ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Black"]</td>
                    <td class="text-right">@Model.Bet.Odds.Black</td>
                    <td class="text-right">@Model.Bet.Black.Format()</td>
                </tr>
            }
            if (Model.Bet.Diamonds > 0)
            {
                <tr class="@(settlementResult.Diamonds ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Diamonds"]</td>
                    <td class="text-right">@Model.Bet.Odds.Diamonds</td>
                    <td class="text-right">@Model.Bet.Diamonds.Format()</td>
                </tr>
            }

            if (Model.Bet.Hearts > 0)
            {
                <tr class="@(settlementResult.Hearts ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Hearts"]</td>
                    <td class="text-right">@Model.Bet.Odds.Hearts</td>
                    <td class="text-right">@Model.Bet.Hearts.Format()</td>
                </tr>
            }

            if (Model.Bet.Spades > 0)
            {
                <tr class="@(settlementResult.Spades ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Spades"]</td>
                    <td class="text-right">@Model.Bet.Odds.Spades</td>
                    <td class="text-right">@Model.Bet.Spades.Format()</td>
                </tr>
            }


            if (Model.Bet.Clubs > 0)
            {
                <tr class="@(settlementResult.Clubs ? "bold text-blue" : string.Empty)">
                    <td>@Localizer["Clubs"]</td>
                    <td class="text-right">@Model.Bet.Odds.Clubs</td>
                    <td class="text-right">@Model.Bet.Clubs.Format()</td>
                </tr>
            }
            <tr>
                <td class="text-right" colspan="2">@CommonLocalizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.Format()</td>
            </tr>
            <tr>
                <td class="text-right" colspan="2">@CommonLocalizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalWin.Format()</td>
            </tr>

            <tr class="total">
                <td class="bold text-right" colspan="2">@CommonLocalizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.Format()</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @CommonLocalizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>