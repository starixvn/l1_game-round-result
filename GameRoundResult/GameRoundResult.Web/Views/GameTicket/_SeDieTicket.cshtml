@model SeDieTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer


<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["Time"] (GMT-4)</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    @foreach (var chip in Model.RoundResult.RedChips)
                    {
                        <i class="@(chip ? "red-chip" : "white-chip")"></i>
                    }
                </td>
                <td class="bold @(Model.RoundResult.IsEven ? "text-blue" : "text-red")">
                    @(Model.RoundResult.IsEven ? Localizer["Even"] : Localizer ["Odd"])

                    @if (Model.RoundResult.TotalRed != 2)
                    {
                        var totalRed = Model.RoundResult.TotalRed;

                        @(totalRed > 0 ? $", {totalRed} red" : ", 4 white")
                    }
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bet != null)
        {
            <tr>
                <td>@Localizer["Odd"]</td>
                <td>@Model.Bet.Odd</td>
            </tr>
            <tr>
                <td>@Localizer["Even"]</td>
                <td>@Model.Bet.Even</td>
            </tr>
            <tr>
                <td>@Localizer["3Red"]</td>
                <td>@Model.Bet.ThreeRed</td>
            </tr>
            <tr>
                <td>@Localizer["4Red"]</td>
                <td>@Model.Bet.FourRed</td>
            </tr>
            <tr>
                <td>@Localizer["3White"]</td>
                <td>@Model.Bet.ThreeWhite</td>
            </tr>
            <tr>
                <td>@Localizer["4White"]</td>
                <td>@Model.Bet.FourWhite</td>
            </tr>
            <tr>
                <td>@Localizer["Total"]</td>
                <td>@Model.TotalBet</td>
            </tr>
            <tr>
                <td>@Localizer["TotalWin"]</td>
                <td>@Model.TotalWin</td>
            </tr>
            <tr>
                <td class="bold">@Localizer["WinLoss"]</td>
                <td class="bold @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>