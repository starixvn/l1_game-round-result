@model BigSmallTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Time"] (GMT-4)</th>
            <th class="col-round-id">@Localizer["RoundId"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["Total"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    @foreach (var dice in Model.RoundResult.Dices)
                    {
                        <img class="dice" src="/scss/images/dice_@(dice).png">
                    }
                </td>
                <td>@Model.RoundResult.Total</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["BetTime"] (GMT-4)</th>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
            <th>@Localizer["Refund"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bets.Any() && Model.RoundResult != null)
        {
            foreach (var bet in Model.Bets)
            {
                <tr>
                    <td>@bet.Time.ToString(ViewFormat.TicketDateTimeFormat)</td>
                    <td>@(bet.Select ? Localizer["Big"]: Localizer["Small"])</td>
                    <td class="text-right">@bet.Bet.ToString(ViewFormat.NumberFormat)</td>
                    <td class="text-right">@bet.Back.ToString(ViewFormat.NumberFormat)</td>
                </tr>
            }
            <tr>
                <td></td>
                <td class="text-right">@Localizer["Total"]</td>
                <td class="text-right">@Model.TotalBet.ToString(ViewFormat.NumberFormat)</td>
                <td class="text-right">@Model.TotalBack.ToString(ViewFormat.NumberFormat)</td>
            </tr>
            <tr>
                <td></td>
                <td class="text-right">@Localizer["TotalWin"]</td>
                <td class="text-right">@Model.TotalWin.ToString(ViewFormat.NumberFormat)</td>
                <td></td>
            </tr>
            <tr class="total">
                <td></td>
                <td class="bold text-right">@Localizer["WinLoss"]</td>
                <td class="bold text-right @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss.ToString(ViewFormat.NumberFormat)</td>
                <td></td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>