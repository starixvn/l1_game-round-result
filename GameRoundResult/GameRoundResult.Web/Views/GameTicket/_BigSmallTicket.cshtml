@model BigSmallTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["Time"] (GMT-4)</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["Total"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    @foreach (var dice in Model.RoundResult.Dices)
                    {
                        <img class="dice" src="/scss/images/dice_@(dice).png">
                    }
                </td>
                <td>@Model.RoundResult.Total</td>
                <td class="bold @(Model.RoundResult.IsBig ? "text-red" : "text-blue")">
                    @(Model.RoundResult.IsBig ? Localizer["Big"]: Localizer["Small"])
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    No data available
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["BetTime"] (GMT-4)</th>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
            <th>@Localizer["Refund"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bet in Model.Bets)
        {
            <tr>
                <td>@bet.Time.ToString(ViewFormat.TicketDateTimeFormat)</td>
                <td>@(bet.Select ? Localizer["Big"]: Localizer["Small"])</td>
                <td>@bet.Bet</td>
                <td>@bet.Back</td>
            </tr>
        }

        @if (Model.Bets.Any())
        {
            <tr>
                <td></td>
                <td>@Localizer["Total"]</td>
                <td>@Model.TotalBet</td>
                <td>@Model.TotalBack</td>
            </tr>
            <tr>
                <td></td>
                <td>@Localizer["TotalWin"]</td>
                <td>@Model.TotalWin</td>
                <td></td>
            </tr>
            <tr>
                <td></td>
                <td>@Localizer["WinLoss"]</td>
                <td>@Model.WinLoss</td>
                <td></td>
            </tr>
        }
    </tbody>
</table>