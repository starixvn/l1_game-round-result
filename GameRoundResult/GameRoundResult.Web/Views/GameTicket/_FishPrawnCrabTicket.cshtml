@model GameRoundResult.Web.Models.GameTicket.FishPrawnCrabTicketViewModel

@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["Time"] (GMT-4)</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RoundResult != null)
        {
            <tr>
                <td>@Model.RoundResult.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@Model.RoundResult.Round</td>
                <td>
                    @foreach (var dice in Model.RoundResult.Dices)
                    {
                    <img class="animal" src="~/scss//images//animal_@(dice).png" />
                    }
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>@Localizer["BetChoice"]</th>
            <th>@Localizer["BetAmount"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Bet != null)
        {
            if (Model.Bet.Stag > 0)
            {
                <tr>
                    <td>@Localizer["Stag"]</td>
                    <td>@Model.Bet.Stag</td>
                </tr>
            }
            if (Model.Bet.Gourd > 0)
            {
                <tr>
                    <td>@Localizer["Gourd"]</td>
                    <td>@Model.Bet.Gourd</td>
                </tr>
            }
            if (Model.Bet.Rooster > 0)
            {
                <tr>
                    <td>@Localizer["Rooster"]</td>
                    <td>@Model.Bet.Rooster</td>
                </tr>
            }
            if (Model.Bet.Fish > 0)
            {
                <tr>
                    <td>@Localizer["Fish"]</td>
                    <td>@Model.Bet.Fish</td>
                </tr>
            }
            if (Model.Bet.Crab > 0)
            {
                <tr>
                    <td>@Localizer["Crab"]</td>
                    <td>@Model.Bet.Crab</td>
                </tr>
            }
            if (Model.Bet.Prawn > 0)
            {
                <tr>
                    <td>@Localizer["Prawn"]</td>
                    <td>@Model.Bet.Prawn</td>
                </tr>
            }
            <tr>
                <td class="bold">@Localizer["WinLoss"]</td>
                <td class="bold @(Model.WinLoss < 0 ? "text-red" : string.Empty)">@Model.WinLoss</td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center">
                    @Localizer["NoDataAvailable"]
                </td>
            </tr>
        }
    </tbody>
</table>