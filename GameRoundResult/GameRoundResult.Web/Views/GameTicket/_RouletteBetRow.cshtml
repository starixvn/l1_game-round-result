@model RouletteBetViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<GameTicketViewModel> Localizer

@{
    var rowSpan = 0;
    Dictionary<string, decimal> firstBetType = null;
    string firstBetTypeName = null;
    var dozens = new Dictionary<string, string>()
    {
        {"1", "1-12" },
        {"2", "13-24" },
        {"3", "25-36"  }
    };

    var bigSmall = new Dictionary<string, string>()
    {
        {"small", "1-18" },
        {"big", "19-36" },
    };

    var redBlackResources = new Dictionary<string, string>()
    {
        {"red", "Red" },
        {"black", "Black" },
    };

    var oddEvenResource = new Dictionary<string, string>()
    {
        {"odd", "Odd" },
        {"even", "Even" },
    };

    if (Model.StraightUp.Any())
    {
        rowSpan += Model.StraightUp.Count;
        firstBetType = Model.StraightUp;
        firstBetTypeName = nameof(Model.StraightUp);
    }

    if (Model.Split.Any())
    {
        rowSpan += Model.Split.Count;
        firstBetType = firstBetType ?? Model.Split;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Split);
    }

    if (Model.Street.Any())
    {
        rowSpan += Model.Street.Count;
        firstBetType = firstBetType ?? Model.Street;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Street);
    }

    if (Model.Triangle.Any())
    {
        rowSpan += Model.Triangle.Count;
        firstBetType = firstBetType ?? Model.Triangle;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Triangle);
    }

    if (Model.Corner.Any())
    {
        rowSpan += Model.Corner.Count;
        firstBetType = firstBetType ?? Model.Corner;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Corner);
    }

    if (Model.FourNumbers.Any())
    {
        rowSpan += Model.FourNumbers.Count;
        firstBetType = firstBetType ?? Model.FourNumbers;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.FourNumbers);
    }

    if (Model.Line.Any())
    {
        rowSpan += Model.Line.Count;
        firstBetType = firstBetType ?? Model.Line;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Line);
    }

    if (Model.Column.Any())
    {
        rowSpan += Model.Column.Count;
        firstBetType = firstBetType ?? Model.Column;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Column);
    }

    if (Model.Dozen.Any())
    {
        rowSpan += Model.Dozen.Count;
        firstBetType = firstBetType ?? Model.Dozen;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.Dozen);
    }

    if (Model.RedBlack.Any())
    {
        rowSpan += Model.RedBlack.Count;
        firstBetType = firstBetType ?? Model.RedBlack;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.StraightUp);
    }

    if (Model.OddEven.Any())
    {
        rowSpan += Model.OddEven.Count;
        firstBetType = firstBetType ?? Model.OddEven;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.OddEven);
    }

    if (Model.BigSmall.Any())
    {
        rowSpan += Model.BigSmall.Count;
        firstBetType = firstBetType ?? Model.BigSmall;
        firstBetTypeName = firstBetTypeName ?? nameof(Model.BigSmall);
    }
}

<tr>
    <td rowspan="@rowSpan">
        @Model.Time.ToString(ViewFormat.TicketDateFormat)
        <br />
        @Model.Time.ToString(ViewFormat.TicketTimeFormat, CultureInfo.InvariantCulture)
    </td>
    <td>@Localizer[firstBetTypeName]</td>
    <td>
        @firstBetType.FirstOrDefault().Key
    </td>
    <td class="text-right">
        @firstBetType.FirstOrDefault().Value.Format()
    </td>
</tr>

@if (firstBetType.Count > 1)
{
    foreach (var betChoice in firstBetType.Skip(1))
    {
        <tr>
            <td>@Localizer[firstBetTypeName]</td>

            <td>
                @betChoice.Key
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>

    }
}

@if (Model.StraightUp.Any() && firstBetType != Model.StraightUp)
{
    foreach (var betChoice in Model.StraightUp)
    {
        <tr>
            <td>@Localizer["StraightUp"]</td>
            <td>
                @betChoice.Key
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.Split.Any() && firstBetType != Model.Split)
{
    foreach (var betChoice in Model.Split)
    {
        <tr>
            <td>@Localizer["Split"]</td>
            <td>
                @betChoice.Key.Replace("-", ", ")
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.Street.Any() && firstBetType != Model.Street)
{
    foreach (var betChoice in Model.Street)
    {
        <tr>
            <td>@Localizer["Street"]</td>
            <td>
                @betChoice.Key.Replace("-", ", ")
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.Triangle.Any() && firstBetType != Model.Triangle)
{
    foreach (var betChoice in Model.Triangle)
    {
        <tr>
            <td>@Localizer["Triangle"]</td>
            <td>
                @betChoice.Key.Replace("-", ", ")
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.Corner.Any() && firstBetType != Model.Corner)
{
    foreach (var betChoice in Model.Corner)
    {
        <tr>
            <td>@Localizer["Corner"]</td>
            <td>
                @betChoice.Key.Replace("-", ", ")
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}


@if (Model.FourNumbers.Any() && firstBetType != Model.FourNumbers)
{
    foreach (var betChoice in Model.FourNumbers)
    {
        <tr>
            <td>@Localizer["FourNumbers"]</td>
            <td>
                @betChoice.Key.Replace("-", ", ")
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}


@if (Model.Line.Any() && firstBetType != Model.Line)
{
    foreach (var betChoice in Model.Line)
    {
        <tr>
            <td>@Localizer["Line"]</td>
            <td>
                @{
                    var splits = betChoice.Key.Split('-');
                }
                <div>@splits[0], @splits[1], @splits[2]</div>
                <div>@splits[3], @splits[4], @splits[5]</div>
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}


@if (Model.Column.Any() && firstBetType != Model.Column)
{
    foreach (var betChoice in Model.Column)
    {
        <tr>
            <td>@Localizer["Column"]</td>
            <td>
                @Localizer[$"column-{betChoice.Key}"]
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}


@if (Model.Dozen.Any() && firstBetType != Model.Dozen)
{
    foreach (var betChoice in Model.Dozen)
    {
        <tr>
            <td>@Localizer["Dozen"]</td>
            <td>
                @dozens[betChoice.Key]
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.RedBlack.Any() && firstBetType != Model.RedBlack)
{
    foreach (var betChoice in Model.RedBlack)
    {
        <tr>
            <td>@Localizer["RedBlack"]</td>
            <td >
                @Localizer[redBlackResources[betChoice.Key]]
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.OddEven.Any() && firstBetType != Model.OddEven)
{
    foreach (var betChoice in Model.OddEven)
    {
        <tr>
            <td>@Localizer["OddEven"]</td>
            <td class="text-capitalize">
                @Localizer[oddEvenResource[betChoice.Key]]
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}

@if (Model.BigSmall.Any() && firstBetType != Model.BigSmall)
{
    foreach (var betChoice in Model.BigSmall)
    {
        <tr>
            <td>@Localizer["BigSmall"]</td>
            <td>
                @bigSmall[betChoice.Key]
            </td>
            <td class="text-right">
                @betChoice.Value.Format()
            </td>
        </tr>
    }
}