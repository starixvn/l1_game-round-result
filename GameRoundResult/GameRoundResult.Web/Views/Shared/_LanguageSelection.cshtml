@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options

@inject IOptions<RequestLocalizationOptions> cultureOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var supportedCultures = cultureOptions.Value.SupportedCultures;
}

    <button id="language" class="language">
        <span class="flag-@requestCulture.RequestCulture.Culture.Name"></span>
        <span class="lang">@requestCulture.RequestCulture.Culture.DisplayName</span>
        <i class="arrow-sm-down"></i>
    </button>

<ul id="language-options" class="language-options">
    @foreach (var culture in supportedCultures)
    {
        <li><a href="/@culture.Name"><span class="flag-@culture.Name"></span> @culture.DisplayName</a></li>
    }
</ul>