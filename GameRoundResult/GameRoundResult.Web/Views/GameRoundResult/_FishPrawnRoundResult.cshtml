@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<FishPrawnRoundResultViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@item.Round</td>
                <td>
                    @foreach (var dice in item.Dices)
                    {
                        <img src="~/scss/images/animal_@(dice).png" class="animal" />
                    }
                </td>
           </tr>
        }
    </tbody>
</table>