@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<KenoProMaxRoundResultViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th rowspan="2" class="col-date">@Localizer["Date"]</th>
            <th rowspan="2">@Localizer["Round"]</th>
            <th rowspan="2">@Localizer["Result"]</th>
            <th rowspan="2">@Localizer["TotalPoints"]</th>
            <th colspan="3">@Localizer["WinningOptions"]</th>
        </tr>
        <tr>
            <th>@Localizer["Big/Small"]</th>
            <th>@Localizer["Even/Odd"]</th>
            <th>@Localizer["Element"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@item.Round</td>
                <td>
                    @foreach (var number in item.Result)
                    {
                        <span>@number</span>
                    }
                </td>
                <td>@item.Total</td>
                <td>
                    @if (item.IsBig)
                    {
                        <span class="text-red bold">@Localizer["Big"]</span>
                    }
                    else
                    {
                        <span class="text-blue bold">@Localizer["Small"]</span>
                    }
                </td>
                <td>
                    @if (item.IsEven)
                    {
                        <span class="text-red bold">@Localizer["Even"]</span>
                    }
                    else
                    {
                        <span class="text-blue bold">@Localizer["Odd"]</span>
                    }
                </td>
                <td>
                    @if (item.IsEarth)
                    {
                        <span class="icon-earth"></span>
                    }
                    @if (item.IsGold)
                    {
                        <span class="icon-earth"></span>
                    }
                    @if (item.IsWood)
                    {
                        <span class="icon-wood"></span>
                    }
                    @if (item.IsWater)
                    {
                        <span class="icon-water"></span>
                    }
                    @if (item.IsFire)
                    {
                        <span class="icon-fire"></span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>