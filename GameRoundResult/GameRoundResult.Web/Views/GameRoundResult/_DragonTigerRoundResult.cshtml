@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Results"] (@Localizer["Dragon"] | @Localizer["Tiger"])</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>