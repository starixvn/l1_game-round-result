@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<DragonTigerRoundResultViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th class="col-date">@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"] (@Localizer["Dragon"] | @Localizer["Tiger"])</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@item.Round</td>
                <td>
                    <div class="card-type-@item.Dragon.Type">
                        <span>@item.Dragon.Number</span>
                    </div>
                    |
                    <div class="card-type-@item.Tiger.Type">
                        <span> @item.Tiger.Number</span>
                    </div>
                </td>
                <td>
                    @if (item.Dragon.Number > item.Tiger.Number)
                    {
                        @Localizer["Dragon"]
                    }
                    else
                    {
                        @if (item.Dragon.Number < item.Tiger.Number)
                        {
                            @Localizer["Tiger"]
                        }
                        else
                        {
                            @Localizer["Draw"]
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>