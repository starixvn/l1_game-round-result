@using Microsoft.AspNetCore.Mvc.Localization
@using GameRoundResult.Core.Constants
@inject IViewLocalizer Localizer

@model IEnumerable<BigSmallRoundResultViewModel>

<table>
    <thead>
        <tr>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["Sum"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString()</td>
                <td>@item.Round</td>
                <td>@item.Dice1 - @item.Dice2 - @item.Dice3</td>
                <td>@item.Total</td>
                <td>@(item.Total > 10 ? Localizer["Big"] : Localizer["Small"])</td>
            </tr>
        }
    </tbody>
</table>