@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<ShakeThePlateRoundResultViewModel>

<table>
    <thead>
        <tr>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@item.Round</td>
                <td>
                    @foreach (var chip in item.RedChips)
                    {
                        if (chip)
                        {
                            <i class="red-chip" />
                        }
                        else
                        {
                            <i class="white-chip" />
                        }
                    }
                </td>
                <td>
                    @(item.IsEven ? Localizer["Even"] : Localizer["Odd"]), @Localizer["{0} red", item.TotalRed]
                </td>
            </tr>
        }
    </tbody>
</table>