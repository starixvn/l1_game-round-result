@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<OddEvenRoundResultViewModel>

<table>
    <thead>
        <tr>
            <th>@Localizer["Date"]</th>
            <th>@Localizer["Round"]</th>
            <th>@Localizer["Result"]</th>
            <th>@Localizer["TotalPoints"]</th>
            <th>@Localizer["WinningOptions"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Time.ToString(ViewFormat.DateTimeFormat)</td>
                <td>@item.Round</td>
                <td>@string.Join(" - ", item.Dices)</td>
                <td>@item.Total</td>
                <td>@(item.Total % 2 == 0 ? Localizer["Even"] : Localizer["Odd"])</td>
            </tr>
        }
    </tbody>
</table>